    content: "  const handleFileUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n    if (fileInputRef.current) fileInputRef.current.value = \'\';\n\n    setErrorMsg(\'\');\n    setIsProcessingFile(true);\n    const statusChunkId = Date.now();\n    setChunks(prev => [...prev, {\n      id: statusChunkId,\n      text: `\346\255\243\345\234\250\346\272\226\345\202\231\350\231\225\347\220\206\351\214\204\351\237\263\346\252\224\357\274\232${file.name}...`,\n      isAnalyzing: true\n    }]);\n\n    try {\n      if (file.size < 20 * 1024 * 1024 && !file.name.toLowerCase().endsWith(\'.m4a\')) {\n        await processFileDirectly(file, statusChunkId);\n      } else if (useCompatibilityMode) {\n        await processFileBySlicing(file, statusChunkId);\n      } else {\n        // For large files or M4A, we NEED FFmpeg\n        if (isFfmpegLoading && !ffmpegLoadedRef.current) {\n          setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\350\231\225\347\220\206\347\265\204\344\273\266\350\274\211\345\205\245\344\270\255\357\274\214\350\253\213\347\250\215\345\200\231...` } : c));\n          \n          // Wait for ffmpegLoadedRef.current to become true (max 60 seconds)\n          let waitTime = 0;\n          while (!ffmpegLoadedRef.current && waitTime < 60) {\n            await new Promise(resolve => setTimeout(resolve, 1000));\n            waitTime++;\n            // If it failed during wait, break early\n            if (ffmpegError) break;\n          }\n          \n          if (!ffmpegLoadedRef.current) {\n            console.warn(\'FFmpeg load timeout, falling back to slicing mode\');\n            await processFileBySlicing(file, statusChunkId);\n            return;\n          }\n        }\n\n        if (ffmpegLoadedRef.current) {"
    raw_content: "import { useState, useEffect, useRef } from \'react\';\nimport { GoogleGenAI } from \'@google/genai\';\nimport ReactMarkdown from \'react-markdown\';\nimport remarkGfm from \'remark-gfm\';\nimport { FileText, Loader2, Send, Copy, Check, Mic, Square, Scissors, AlertCircle, Upload, Zap } from \'lucide-react\';\nimport { FFmpeg } from \'@ffmpeg/ffmpeg\';\nimport { fetchFile, toBlobURL } from \'@ffmpeg/util\';\n\nconst ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\n\nconst SYSTEM_PROMPT = `\n# Role\n\344\275\240\346\230\257\344\270\200\344\275\215\345\260\210\346\245\255\343\200\201\345\205\267\345\202\231\351\253\230\345\272\246\351\202\217\350\274\257\344\270\224\346\225\217\351\212\263\347\232\204\351\253\230\351\232\216\345\260\210\346\241\210\347\247\230\346\233\270\343\200\202\344\275\240\347\232\204\344\273\273\345\213\231\346\230\257\345\260\207\345\206\227\351\225\267\343\200\201\345\217\257\350\203\275\347\274\272\344\271\217\347\265\204\347\271\224\347\232\204\346\234\203\350\255\260\351\200\220\345\255\227\347\250\277\346\210\226\351\214\204\351\237\263\346\221\230\350\246\201\357\274\214\347\262\276\346\272\226\346\217\220\347\205\211\347\202\272\347\265\220\346\247\213\345\214\226\343\200\201\351\253\230\345\217\257\350\256\200\346\200\247\347\232\204\345\260\210\346\245\255\346\234\203\350\255\260\347\264\200\351\214\204 Email\343\200\202\n\n# Objective\n\345\276\236\346\217\220\344\276\233\347\232\204\346\234\203\350\255\260\345\205\247\345\256\271\344\270\255\357\274\214\350\220\203\345\217\226\345\207\272\346\240\270\345\277\203\346\261\272\350\255\260\343\200\201\350\250\216\350\253\226\350\204\210\347\265\241\343\200\201\345\276\205\350\276\246\344\272\213\351\240\205\344\273\245\345\217\212\346\275\233\345\234\250\351\242\250\351\232\252\357\274\214\344\270\246\345\232\264\346\240\274\346\214\211\347\205\247\346\214\207\345\256\232\347\232\204\346\240\274\345\274\217\350\210\207\350\252\236\346\260\243\350\274\270\345\207\272\343\200\202\n\n# Guidelines\n1. \350\263\207\350\250\212\350\220\203\345\217\226\357\274\232\345\277\275\347\225\245\346\234\203\350\255\260\344\270\255\347\232\204\351\226\222\350\201\212\343\200\201\345\206\227\350\251\236\350\264\205\345\255\227\350\210\207\347\204\241\351\227\234\347\267\212\350\246\201\347\232\204\347\264\260\347\257\200\343\200\202\345\260\210\346\263\250\346\226\274\343\200\214\350\252\260\345\234\250\344\273\200\351\272\274\346\231\202\351\226\223\351\273\236\345\211\215\351\234\200\350\246\201\345\256\214\346\210\220\344\273\200\351\272\274\344\272\213\343\200\215\344\273\245\345\217\212\343\200\214\351\201\224\346\210\220\344\272\206\344\273\200\351\272\274\345\205\261\350\255\230\343\200\215\343\200\202\n2. \350\252\236\346\260\243\350\210\207\351\242\250\346\240\274\357\274\232\344\277\235\346\214\201\345\256\242\350\247\200\343\200\201\345\260\210\346\245\255\343\200\201\347\262\276\347\205\211\347\232\204\345\225\206\345\213\231\350\252\236\346\260\243\343\200\202\n3. \347\265\220\346\247\213\344\270\200\350\207\264\346\200\247\357\274\232\347\265\225\345\260\215\351\201\265\345\256\210\344\270\213\346\226\271\345\256\232\347\276\251\347\232\204\350\274\270\345\207\272\346\250\241\346\235\277\343\200\202\n4. \346\264\236\345\257\237\345\212\233\357\274\232\345\234\250\343\200\214\347\247\230\346\233\270\350\247\200\345\257\237\350\210\207\345\273\272\350\255\260\343\200\215\345\215\200\345\241\212\357\274\214\351\273\236\345\207\272\350\267\250\351\203\250\351\226\200\345\215\224\344\275\234\347\232\204\346\275\233\345\234\250\351\242\250\351\232\252\346\210\226\347\256\241\347\220\206\345\261\244\351\235\242\347\232\204\345\203\271\345\200\274\345\273\272\350\255\260\343\200\202\n\n# Output Format\n\350\253\213\344\275\277\347\224\250 Markdown \347\265\220\346\247\213\350\210\207\350\241\250\346\240\274\346\240\274\345\274\217\350\274\270\345\207\272\346\234\203\350\255\260\347\264\200\351\214\204\357\274\214\345\214\205\345\220\253\357\274\232\346\234\203\350\255\260\345\237\272\346\234\254\350\263\207\350\250\212\343\200\201\344\270\200\343\200\201\346\234\203\350\255\260\351\207\215\351\273\236\346\221\230\350\246\201\343\200\201\344\272\214\343\200\201\346\234\203\350\255\260\344\270\273\351\241\214\350\210\207\350\203\214\346\231\257\343\200\201\344\270\211\343\200\201\345\220\204\351\240\205\350\255\260\351\241\214\350\250\216\350\253\226\350\210\207\346\261\272\350\255\260\343\200\201\345\233\233\343\200\201\346\234\203\350\255\260\351\207\215\351\273\236\346\242\235\345\210\227\343\200\201\344\272\224\343\200\201\345\276\205\350\276\246\344\272\213\351\240\205\350\277\275\350\271\244\346\270\205\345\226\256\343\200\201\345\205\255\343\200\201\347\247\230\346\233\270\350\247\200\345\257\237\350\210\207\345\273\272\350\255\260\343\200\202\n`;\n\ndeclare global {\n  interface Window {\n    SpeechRecognition: any;\n    webkitSpeechRecognition: any;\n  }\n}\n\ninterface Chunk {\n  id: number;\n  text: string;\n  transcript?: string;\n  summary?: string;\n  isAnalyzing: boolean;\n  audio?: {\n    fileName: string;\n    mimeType: string;\n    data: string;\n  };\n}\n\nexport default function App() {\n  const [isRecording, setIsRecording] = useState(false);\n  const [interimText, setInterimText] = useState(\'\');\n  const [currentChunkText, setCurrentChunkText] = useState(\'\');\n  const [chunks, setChunks] = useState<Chunk[]>([]);\n  const [finalReport, setFinalReport] = useState(\'\');\n  const [isGeneratingFinal, setIsGeneratingFinal] = useState(false);\n  const [copied, setCopied] = useState(false);\n  const [errorMsg, setErrorMsg] = useState(\'\');\n  const [isProcessingFile, setIsProcessingFile] = useState(false);\n  const [ffmpegLoaded, setFfmpegLoaded] = useState(false);\n  const [isFfmpegLoading, setIsFfmpegLoading] = useState(true);\n  const [ffmpegError, setFfmpegError] = useState(false);\n  const [ffmpegLoadingStatus, setFfmpegLoadingStatus] = useState(\'\');\n  const [useCompatibilityMode, setUseCompatibilityMode] = useState(false);\n\n  const ffmpegRef = useRef(new FFmpeg());\n  const ffmpegLoadedRef = useRef(false);\n  const recognitionRef = useRef<any>(null);\n  const isRecordingRef = useRef(false);\n  const currentChunkRef = useRef(\'\');\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  useEffect(() => {\n    loadFFmpeg();\n  }, []);\n\n  const loadFFmpeg = async () => {\n    setIsFfmpegLoading(true);\n    setFfmpegError(false);\n    setFfmpegLoadingStatus(\'\346\255\243\345\234\250\345\210\235\345\247\213\345\214\226...\');\n    \n    const cdns = [\n      { name: \'jsDelivr (\346\216\250\350\226\246)\', url: \'https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/umd\' },\n      { name: \'unpkg (\345\202\231\346\217\264)\', url: \'https://unpkg.com/@ffmpeg/core@0.12.6/dist/umd\' }\n    ];\n    \n    const ffmpeg = ffmpegRef.current;\n    \n    ffmpeg.on(\'log\', ({ message }) => {\n      console.log(\'FFmpeg Log:\', message);\n      if (message.includes(\'Loading\')) setFfmpegLoadingStatus(`\350\274\211\345\205\245\344\270\255: ${message}`);\n    });\n\n    let loaded = false;\n    for (const cdn of cdns) {\n      try {\n        setFfmpegLoadingStatus(`\346\255\243\345\234\250\345\276\236 ${cdn.name} \344\270\213\350\274\211\346\240\270\345\277\203\347\265\204\344\273\266...`);\n        console.log(`Attempting to load FFmpeg from ${cdn.url}...`);\n        \n        // Create a timeout promise\n        const timeoutPromise = new Promise((_, reject) => \n          setTimeout(() => reject(new Error(\'Timeout\')), 30000) // 30s timeout per CDN\n        );\n\n        const loadPromise = ffmpeg.load({\n          coreURL: await toBlobURL(`${cdn.url}/ffmpeg-core.js`, \'text/javascript\'),\n          wasmURL: await toBlobURL(`${cdn.url}/ffmpeg-core.wasm`, \'application/wasm\'),\n        });\n\n        await Promise.race([loadPromise, timeoutPromise]);\n        \n        loaded = true;\n        console.log(`FFmpeg loaded successfully from ${cdn.url}`);\n        break;\n      } catch (err) {\n        console.warn(`Failed to load FFmpeg from ${cdn.url}`, err);\n        setFfmpegLoadingStatus(`${cdn.name} \350\274\211\345\205\245\345\244\261\346\225\227\357\274\214\345\230\227\350\251\246\344\270\213\344\270\200\345\200\213\347\257\200\351\273\236...`);\n      }\n    }\n\n    if (loaded) {\n      setFfmpegLoaded(true);\n      ffmpegLoadedRef.current = true;\n      setIsFfmpegLoading(false);\n      setFfmpegLoadingStatus(\'\');\n    } else {\n      setFfmpegError(true);\n      setIsFfmpegLoading(false);\n      setFfmpegLoadingStatus(\'\346\211\200\346\234\211\347\257\200\351\273\236\345\235\207\350\274\211\345\205\245\345\244\261\346\225\227\');\n    }\n  };\n\n  const fileToBase64 = (file: Blob | File): Promise<string> => {\n    return new Promise((resolve, reject) => {\n      const reader = new FileReader();\n      reader.onload = () => resolve((reader.result as string).split(\',\')[1]);\n      reader.onerror = reject;\n      reader.readAsDataURL(file);\n    });\n  };\n\n  const handleFileUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n    if (fileInputRef.current) fileInputRef.current.value = \'\';\n\n    setErrorMsg(\'\');\n    setIsProcessingFile(true);\n    const statusChunkId = Date.now();\n    setChunks(prev => [...prev, {\n      id: statusChunkId,\n      text: `\346\255\243\345\234\250\346\272\226\345\202\231\350\231\225\347\220\206\351\214\204\351\237\263\346\252\224\357\274\232${file.name}...`,\n      isAnalyzing: true\n    }]);\n\n    try {\n      if (file.size < 20 * 1024 * 1024 && !file.name.toLowerCase().endsWith(\'.m4a\')) {\n        await processFileDirectly(file, statusChunkId);\n      } else if (useCompatibilityMode) {\n        await processFileBySlicing(file, statusChunkId);\n      } else {\n        // For large files or M4A, we NEED FFmpeg\n        if (isFfmpegLoading && !ffmpegLoadedRef.current) {\n          setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\350\231\225\347\220\206\347\265\204\344\273\266\350\274\211\345\205\245\344\270\255\357\274\214\350\253\213\347\250\215\345\200\231...` } : c));\n          \n          // Wait for ffmpegLoadedRef.current to become true (max 60 seconds)\n          let waitTime = 0;\n          while (!ffmpegLoadedRef.current && waitTime < 60) {\n            await new Promise(resolve => setTimeout(resolve, 1000));\n            waitTime++;\n            // If it failed during wait, break early\n            if (ffmpegError) break;\n          }\n          \n          if (!ffmpegLoadedRef.current) {\n            console.warn(\'FFmpeg load timeout, falling back to slicing mode\');\n            await processFileBySlicing(file, statusChunkId);\n            return;\n          }\n        }\n\n        if (ffmpegLoadedRef.current) {\n          await processFileWithFFmpeg(file, statusChunkId);\n        } else {\n          // Fallback for large files when FFmpeg fails\n          if (file.size > 20 * 1024 * 1024) {\n            await processFileBySlicing(file, statusChunkId);\n          } else {\n            await processFileLegacy(file, statusChunkId);\n          }\n        }\n      }\n    } catch (e: any) {\n      console.error(\'Audio processing failed\', e);\n      setErrorMsg(e.message || \'\351\237\263\346\252\224\350\231\225\347\220\206\345\244\261\346\225\227\343\200\202\');\n      setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n    } finally {\n      setIsProcessingFile(false);\n    }\n  };\n\n  const processFileDirectly = async (file: File, statusChunkId: number) => {\n    const base64Data = await fileToBase64(file);\n    const segmentChunk: Chunk = {\n      id: Date.now(),\n      text: `\351\214\204\351\237\263\346\252\224\357\274\232${file.name}`,\n      isAnalyzing: true,\n      audio: { fileName: file.name, mimeType: file.type || \'audio/mpeg\', data: base64Data }\n    };\n    setChunks(prev => [...prev.filter(c => c.id !== statusChunkId), segmentChunk]);\n    analyzeChunk(segmentChunk);\n  };\n\n  const processFileWithFFmpeg = async (file: File, statusChunkId: number) => {\n    const ffmpeg = ffmpegRef.current;\n    const inputExt = file.name.substring(file.name.lastIndexOf(\'.\')) || \'.m4a\';\n    const inputName = \'input\' + inputExt;\n    \n    setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\346\255\243\345\234\250\351\200\262\350\241\214\351\253\230\346\225\210\350\203\275\345\210\207\347\211\207\350\231\225\347\220\206\357\274\232${file.name}...` } : c));\n    \n    await ffmpeg.writeFile(inputName, await fetchFile(file));\n    \n    // Slice into 10-minute segments without re-encoding (very fast)\n    // We use .mp3 as output for better compatibility if possible, or keep original extension\n    const outputExt = \'.mp3\'; \n    await ffmpeg.exec([\'-i\', inputName, \'-f\', \'segment\', \'-segment_time\', \'600\', \'-c\', \'copy\', `out%03d${outputExt}`]);\n\n    const files = await ffmpeg.listDir(\'.\');\n    const outputFiles = files.filter(f => f.name.startsWith(\'out\') && !f.isDir);\n    \n    setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n\n    for (let i = 0; i < outputFiles.length; i++) {\n      const fileName = outputFiles[i].name;\n      const data = await ffmpeg.readFile(fileName);\n      const blob = new Blob([data], { type: \'audio/mpeg\' });\n      const base64Data = await fileToBase64(blob);\n\n      const segmentChunk: Chunk = {\n        id: Date.now() + i,\n        text: `\351\214\204\351\237\263\345\210\206\346\256\265 ${i + 1}/${outputFiles.length} (\347\264\204\347\254\254 ${i * 10} \345\210\206\351\220\230\350\265\267)`,\n        isAnalyzing: true,\n        audio: { fileName: `${file.name} (Part ${i + 1})`, mimeType: \'audio/mpeg\', data: base64Data }\n      };\n\n      setChunks(prev => [...prev, segmentChunk]);\n      analyzeChunk(segmentChunk);\n      await ffmpeg.deleteFile(fileName);\n    }\n    await ffmpeg.deleteFile(inputName);\n  };\n\n  const processFileBySlicing = async (file: File, statusChunkId: number) => {\n    const CHUNK_SIZE = 8 * 1024 * 1024; // 8MB chunks to stay well within 20MB base64 limit\n    const totalChunks = Math.ceil(file.size / CHUNK_SIZE);\n    \n    setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\346\255\243\345\234\250\344\273\245\343\200\214\347\233\270\345\256\271\345\210\207\347\211\207\346\250\241\345\274\217\343\200\215\350\231\225\347\220\206\344\270\255 (${file.name})...` } : c));\n\n    for (let i = 0; i < totalChunks; i++) {\n      const start = i * CHUNK_SIZE;\n      const end = Math.min(start + CHUNK_SIZE, file.size);\n      const blob = file.slice(start, end);\n      const base64Data = await fileToBase64(blob);\n\n      const segmentChunk: Chunk = {\n        id: Date.now() + i,\n        text: `\351\214\204\351\237\263\345\210\206\346\256\265 ${i + 1}/${totalChunks} (\347\233\270\345\256\271\346\250\241\345\274\217 - \347\264\204\347\254\254 ${i * 5} \345\210\206\351\220\230\350\265\267)`,\n        isAnalyzing: true,\n        audio: { fileName: `${file.name} (Part ${i + 1})`, mimeType: file.type || \'audio/mpeg\', data: base64Data }\n      };\n\n      // Remove status chunk when adding the first real chunk\n      if (i === 0) {\n        setChunks(prev => [...prev.filter(c => c.id !== statusChunkId), segmentChunk]);\n      } else {\n        setChunks(prev => [...prev, segmentChunk]);\n      }\n      \n      await analyzeChunk(segmentChunk);\n      // Add a small delay between sequential requests to be extra safe with rate limits\n      await new Promise(resolve => setTimeout(resolve, 1500));\n    }\n  };\n\n  const processFileLegacy = async (file: File, statusChunkId: number) => {\n    const arrayBuffer = await file.arrayBuffer();\n    const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();\n    const decodedData = await audioCtx.decodeAudioData(arrayBuffer);\n    const wavBlob = new Blob([audioBufferToWav(decodedData)], { type: \'audio/wav\' });\n    const base64Data = await fileToBase64(wavBlob);\n    \n    const segmentChunk: Chunk = {\n      id: Date.now(),\n      text: `\351\214\204\351\237\263\346\252\224\357\274\232${file.name} (\347\233\270\345\256\271\346\250\241\345\274\217)`,\n      isAnalyzing: true,\n      audio: { fileName: file.name, mimeType: \'audio/wav\', data: base64Data }\n    };\n    setChunks(prev => [...prev.filter(c => c.id !== statusChunkId), segmentChunk]);\n    analyzeChunk(segmentChunk);\n    audioCtx.close();\n  };\n\n  const analyzeChunk = async (chunk: Chunk, retryCount = 0): Promise<void> => {\n    if (!chunk.audio) return;\n    try {\n      // Use Gemini 2.0 Flash for stable and accurate transcription as requested\n      const response = await ai.models.generateContent({\n        model: \'gemini-2.0-flash\',\n        contents: {\n          parts: [\n            { inlineData: { mimeType: chunk.audio.mimeType, data: chunk.audio.data } },\n            { text: \'\350\253\213\345\260\207\351\200\231\346\256\265\351\237\263\350\250\212\345\205\247\345\256\271\347\262\276\346\272\226\350\275\211\351\214\204\347\202\272\351\200\220\345\255\227\347\250\277\343\200\202\350\253\213\347\233\264\346\216\245\350\274\270\345\207\272\345\260\215\350\251\261\345\205\247\345\256\271\357\274\214\344\270\215\351\234\200\350\246\201\344\273\273\344\275\225\351\226\213\345\240\264\347\231\275\346\210\226\350\247\243\351\207\213\343\200\202\' }\n          ]\n        }\n      });\n      setChunks(prev => prev.map(c => c.id === chunk.id ? { ...c, transcript: response.text, isAnalyzing: false } : c));\n    } catch (err: any) {\n      console.error(\'Gemini API Error (Audio):\', err);\n      \n      const errorMsg = err.message || \'\';\n      if (errorMsg.includes(\'429\') || err.status === \'RESOURCE_EXHAUSTED\') {\n        if (retryCount < 3) {\n          const delay = Math.pow(2, retryCount) * 10000; \n          console.log(`Rate limited. Retrying in ${delay}ms... (Attempt ${retryCount + 1})`);\n          await new Promise(resolve => setTimeout(resolve, delay));\n          return analyzeChunk(chunk, retryCount + 1);\n        }\n      }\n\n      const errorDetail = errorMsg || \'\350\275\211\351\214\204\345\244\261\346\225\227\';\n      setChunks(prev => prev.map(c => c.id === chunk.id ? { ...c, transcript: `\350\275\211\351\214\204\345\244\261\346\225\227: ${errorDetail}`, isAnalyzing: false } : c));\n    }\n  };\n\n  function audioBufferToWav(buffer: AudioBuffer) {\n    const numOfChan = buffer.numberOfChannels;\n    const length = buffer.length * numOfChan * 2 + 44;\n    const buffer_out = new ArrayBuffer(length);\n    const view = new DataView(buffer_out);\n    let pos = 0;\n    const setUint16 = (data: number) => { view.setUint16(pos, data, true); pos += 2; };\n    const setUint32 = (data: number) => { view.setUint32(pos, data, true); pos += 4; };\n    setUint32(0x46464952); setUint32(length - 8); setUint32(0x45564157);\n    setUint32(0x20746d66); setUint32(16); setUint16(1); setUint16(numOfChan);\n    setUint32(buffer.sampleRate); setUint32(buffer.sampleRate * 2 * numOfChan);\n    setUint16(numOfChan * 2); setUint16(16); setUint32(0x61746164); setUint32(length - pos - 4);\n    for (let i = 0; i < buffer.length; i++) {\n      for (let channel = 0; channel < numOfChan; channel++) {\n        let sample = buffer.getChannelData(channel)[i];\n        sample = Math.max(-1, Math.min(1, sample));\n        view.setInt16(pos, sample < 0 ? sample * 0x8000 : sample * 0x7FFF, true);\n        pos += 2;\n      }\n    }\n    return buffer_out;\n  }\n\n  useEffect(() => {\n    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;\n    if (!SpeechRecognition) return;\n    const recognition = new SpeechRecognition();\n    recognition.continuous = true;\n    recognition.interimResults = true;\n    recognition.lang = \'zh-TW\';\n    recognition.onresult = (event: any) => {\n      let interim = \'\';\n      let final = \'\';\n      for (let i = event.resultIndex; i < event.results.length; ++i) {\n        if (event.results[i].isFinal) final += event.results[i][0].transcript;\n        else interim += event.results[i][0].transcript;\n      }\n      setInterimText(interim);\n      if (final) {\n        currentChunkRef.current += final + \' \';\n        setCurrentChunkText(currentChunkRef.current);\n        if (currentChunkRef.current.length >= 500) commitCurrentChunk();\n      }\n    };\n    recognition.onend = () => { if (isRecordingRef.current) recognition.start(); };\n    recognitionRef.current = recognition;\n  }, []);\n\n  const commitCurrentChunk = async () => {\n    const text = currentChunkRef.current.trim();\n    if (!text) return;\n    const id = Date.now();\n    setChunks(prev => [...prev, { id, text, isAnalyzing: true }]);\n    currentChunkRef.current = \'\';\n    setCurrentChunkText(\'\');\n    setInterimText(\'\');\n    try {\n      const response = await ai.models.generateContent({\n        model: \'gemini-3-flash-preview\',\n        contents: `\350\253\213\347\270\275\347\265\220\351\207\215\351\273\236\357\274\232\\n\\n${text}`,\n      });\n      setChunks(prev => prev.map(c => c.id === id ? { ...c, summary: response.text, isAnalyzing: false } : c));\n    } catch (e: any) {\n      console.error(\'Gemini API Error (Text Chunk):\', e);\n      setChunks(prev => prev.map(c => c.id === id ? { ...c, summary: `\345\210\206\346\236\220\345\244\261\346\225\227: ${e.message || \'\346\234\252\347\237\245\351\214\257\350\252\244\'}`, isAnalyzing: false } : c));\n    }\n  };\n\n  const toggleRecording = () => {\n    if (isRecording) {\n      setIsRecording(false); isRecordingRef.current = false;\n      recognitionRef.current?.stop();\n      if (currentChunkRef.current.trim()) commitCurrentChunk();\n    } else {\n      setErrorMsg(\'\');\n      recognitionRef.current?.start();\n      setIsRecording(true); isRecordingRef.current = true;\n    }\n  };\n\n  const generateFinalReport = async () => {\n    if (chunks.length === 0 && !currentChunkText.trim()) return;\n    setIsGeneratingFinal(true);\n    \n    // Combine all transcripts for a comprehensive analysis\n    const fullTranscript = chunks\n      .map((c, i) => `\343\200\220\345\210\206\346\256\265 ${i + 1} \351\200\220\345\255\227\347\250\277\343\200\221\\n${c.transcript || c.text || \'(\347\204\241\345\205\247\345\256\271)\'}`)\n      .join(\'\\n\\n\');\n\n    try {\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.1-pro-preview\',\n        contents: `\344\273\245\344\270\213\346\230\257\345\256\214\346\225\264\347\232\204\346\234\203\350\255\260\351\200\220\345\255\227\347\250\277\345\205\247\345\256\271\357\274\214\350\253\213\346\240\271\346\223\232\351\200\231\344\272\233\345\205\247\345\256\271\347\224\242\345\207\272\347\265\220\346\247\213\345\214\226\346\234\203\350\255\260\347\264\200\351\214\204\357\274\232\\n\\n${fullTranscript}`,\n        config: { systemInstruction: SYSTEM_PROMPT }\n      });\n      setFinalReport(response.text || \'\');\n    } catch (e: any) {\n      console.error(\'Gemini API Error (Final Report):\', e);\n      setFinalReport(`\347\224\237\346\210\220\345\244\261\346\225\227: ${e.message || \'\346\234\252\347\237\245\351\214\257\350\252\244\'}`);\n    } finally {\n      setIsGeneratingFinal(false);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col\">\n      <header className=\"bg-white border-b border-slate-200 p-4 shrink-0\">\n        <div className=\"max-w-7xl mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"bg-indigo-600 p-2 rounded-lg text-white\"><FileText className=\"w-5 h-5\" /></div>\n            <h1 className=\"text-xl font-semibold\">\351\253\230\351\232\216\345\260\210\346\241\210\347\247\230\346\233\270 <span className=\"text-slate-400 font-normal\">| \350\266\205\351\225\267\351\237\263\346\252\224\350\231\225\347\220\206\347\211\210</span></h1>\n          </div>\n          \n          <div className=\"flex items-center gap-3\">\n            {isFfmpegLoading && (\n              <div className=\"flex flex-col items-end gap-1\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"flex items-center gap-2 text-xs text-amber-600 bg-amber-50 px-3 py-1.5 rounded-full border border-amber-100\">\n                    <Loader2 className=\"w-3 h-3 animate-spin\" />\n                    \347\265\204\344\273\266\350\274\211\345\205\245\344\270\255...\n                  </div>\n                  {!useCompatibilityMode && (\n                    <button \n                      onClick={() => setUseCompatibilityMode(true)}\n                      className=\"text-[10px] text-indigo-600 underline hover:text-indigo-800\"\n                    >\n                      \347\255\211\344\270\215\345\217\212\344\272\206\357\274\237\345\210\207\346\217\233\347\233\270\345\256\271\346\250\241\345\274\217\n                    </button>\n                  )}\n                </div>\n                {ffmpegLoadingStatus && <span className=\"text-[10px] text-slate-400 mr-2\">{ffmpegLoadingStatus}</span>}\n              </div>\n            )}\n            {ffmpegError && (\n              <div className=\"flex flex-col items-end gap-1\">\n                <div className=\"flex items-center gap-2\">\n                  <button \n                    onClick={loadFFmpeg}\n                    className=\"flex items-center gap-2 text-xs text-red-600 bg-red-50 px-3 py-1.5 rounded-full border border-red-100 hover:bg-red-100 transition-colors\"\n                  >\n                    <AlertCircle className=\"w-3 h-3\" />\n                    \347\265\204\344\273\266\350\274\211\345\205\245\345\244\261\346\225\227\357\274\214\351\273\236\346\223\212\351\207\215\350\251\246\n                  </button>\n                  <button \n                    onClick={() => setUseCompatibilityMode(true)}\n                    className=\"text-[10px] text-indigo-600 underline hover:text-indigo-800\"\n                  >\n                    \345\210\207\346\217\233\350\207\263\347\233\270\345\256\271\346\250\241\345\274\217\n                  </button>\n                </div>\n                <span className=\"text-[10px] text-slate-400 mr-2\">\347\266\262\350\267\257\347\222\260\345\242\203\345\217\227\351\231\220\357\274\237\345\273\272\350\255\260\344\275\277\347\224\250\347\233\270\345\256\271\346\250\241\345\274\217</span>\n              </div>\n            )}\n            {useCompatibilityMode && !isFfmpegLoading && !ffmpegError && !ffmpegLoaded && (\n              <div className=\"flex items-center gap-2 text-xs text-indigo-600 bg-indigo-50 px-3 py-1.5 rounded-full border border-indigo-100\">\n                <Zap className=\"w-3 h-3\" />\n                \345\267\262\345\225\237\347\224\250\347\233\270\345\256\271\345\210\207\347\211\207\346\250\241\345\274\217\n              </div>\n            )}\n            {ffmpegLoaded && (\n              <div className=\"flex items-center gap-2 text-xs text-emerald-600 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-100\">\n                <Check className=\"w-3 h-3\" />\n                \345\244\247\345\236\213\346\252\224\346\241\210\350\231\225\347\220\206\345\267\262\345\260\261\347\267\222\n              </div>\n            )}\n          </div>\n        </div>\n      </header>\n\n      <main className=\"flex-1 max-w-7xl w-full mx-auto p-4 grid grid-cols-1 lg:grid-cols-2 gap-6 overflow-hidden\">\n        <div className=\"flex flex-col h-full overflow-hidden\">\n          <div className=\"flex items-center justify-between mb-4\">\n            <h2 className=\"text-lg font-medium\">\351\214\204\351\237\263\350\210\207\345\210\206\346\256\265\345\210\206\346\236\220</h2>\n            {chunks.length > 0 && <button onClick={() => setChunks([])} className=\"text-xs text-slate-400 hover:text-red-500\">\346\270\205\351\231\244\347\264\200\351\214\204</button>}\n          </div>\n          \n          <div className=\"flex flex-wrap gap-2 mb-4\">\n            <button onClick={toggleRecording} className={`flex items-center gap-2 px-4 py-2 rounded-lg text-white ${isRecording ? \'bg-red-500\' : \'bg-indigo-600\'}`}>\n              {isRecording ? <Square className=\"w-4 h-4\" /> : <Mic className=\"w-4 h-4\" />} {isRecording ? \'\345\201\234\346\255\242\' : \'\351\214\204\351\237\263\'}\n            </button>\n            <button onClick={() => fileInputRef.current?.click()} disabled={isProcessingFile} className=\"flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-slate-200 disabled:opacity-50\">\n              {isProcessingFile ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : <Upload className=\"w-4 h-4\" />} {isProcessingFile ? \'\350\231\225\347\220\206\344\270\255\' : \'\344\270\212\345\202\263\'}\n            </button>\n            <input type=\"file\" accept=\"audio/*\" ref={fileInputRef} className=\"hidden\" onChange={handleFileUpload} />\n          </div>\n          \n          {errorMsg && <div className=\"mb-4 p-3 bg-red-50 text-red-700 rounded-lg text-sm flex items-center gap-2\"><AlertCircle className=\"w-4 h-4\" /> {errorMsg}</div>}\n\n          <div className=\"mb-4 p-4 bg-white border border-indigo-100 rounded-xl shadow-sm\">\n            <h3 className=\"text-xs font-bold text-indigo-900 mb-2 uppercase tracking-wider\">\347\225\266\345\211\215\346\224\266\351\237\263</h3>\n            <p className=\"text-sm text-slate-700 min-h-[3rem]\">{currentChunkText}<span className=\"text-slate-400\">{interimText}</span></p>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto space-y-4 pr-2\">\n            {chunks.map((chunk, idx) => (\n              <div key={chunk.id} className=\"p-4 bg-white border border-slate-200 rounded-xl shadow-sm\">\n                <div className=\"flex justify-between mb-2\">\n                  <span className=\"text-xs font-bold text-slate-400\">\345\210\206\346\256\265 {idx + 1}</span>\n                  {chunk.isAnalyzing ? <Loader2 className=\"w-3 h-3 animate-spin text-indigo-500\" /> : <Check className=\"w-3 h-3 text-emerald-500\" />}\n                </div>\n                <p className=\"text-sm text-slate-600 mb-2\">{chunk.text}</p>\n                {chunk.transcript && (\n                  <div className=\"mt-2 text-xs text-slate-500 bg-slate-50 p-3 rounded-lg border border-slate-100 max-h-32 overflow-y-auto\">\n                    <div className=\"font-bold mb-1 text-slate-400 uppercase tracking-tighter\">\351\200\220\345\255\227\347\250\277\345\205\247\345\256\271</div>\n                    {chunk.transcript}\n                  </div>\n                )}\n                {chunk.summary && <div className=\"p-2 bg-indigo-50 rounded text-sm font-medium text-indigo-900 mt-2\">{chunk.summary}</div>}\n              </div>\n            ))}\n          </div>\n        </div>\n\n        <div className=\"flex flex-col h-full overflow-hidden\">\n          <div className=\"flex justify-between mb-4\">\n            <h2 className=\"text-lg font-medium\">\346\234\200\347\265\202\346\234\203\350\255\260\347\264\200\351\214\204</h2>\n            {finalReport && <button onClick={() => { navigator.clipboard.writeText(finalReport); setCopied(true); setTimeout(() => setCopied(false), 2000); }} className=\"text-sm text-indigo-600\">{copied ? \'\345\267\262\350\244\207\350\243\275\' : \'\350\244\207\350\243\275\'}</button>}\n          </div>\n          <button onClick={generateFinalReport} disabled={isGeneratingFinal || chunks.length === 0} className=\"mb-4 w-full bg-slate-900 text-white py-3 rounded-xl disabled:bg-slate-300\">\n            {isGeneratingFinal ? \'\347\224\237\346\210\220\344\270\255...\' : \'\347\224\237\346\210\220\346\234\200\347\265\202\346\234\203\350\255\260\347\264\200\351\214\204\'}\n          </button>\n          <div className=\"flex-1 bg-white border border-slate-200 rounded-xl p-6 overflow-y-auto prose prose-sm max-w-none\">\n            {finalReport ? <ReactMarkdown remarkPlugins={[remarkGfm]}>{finalReport}</ReactMarkdown> : <div className=\"h-full flex items-center justify-center text-slate-300 italic\">\351\273\236\346\223\212\346\214\211\351\210\225\347\224\237\346\210\220\345\240\261\345\221\212</div>}\n          </div>\n        </div>\n      </main>\n    </div>\n  );\n}\n"
