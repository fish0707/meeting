  planner_response {
    response: "\351\207\235\345\260\215\346\202\250\351\201\207\345\210\260\347\232\204 `429 RESOURCE_EXHAUSTED` (\351\205\215\351\241\215\350\266\205\345\207\272) \351\214\257\350\252\244\344\273\245\345\217\212\346\250\241\345\236\213\345\233\236\347\255\224\343\200\214\347\204\241\346\263\225\350\231\225\347\220\206\351\237\263\350\250\212\343\200\215\347\232\204\345\225\217\351\241\214\357\274\214\346\210\221\345\267\262\347\266\223\351\200\262\350\241\214\344\272\206\344\273\245\344\270\213\346\240\270\345\277\203\344\277\256\345\276\251\357\274\232\n\n### 1. \350\247\243\346\261\272\351\205\215\351\241\215\350\266\205\345\207\272 (429 Error)\n*   **\350\207\252\345\213\225\351\207\215\350\251\246\346\251\237\345\210\266**\357\274\232\345\212\240\345\205\245\344\272\206\343\200\214\346\214\207\346\225\270\351\200\200\351\201\277\351\207\215\350\251\246\343\200\215\351\202\217\350\274\257\343\200\202\347\225\266 API \345\233\236\345\240\261\351\205\215\351\241\215\350\266\205\345\207\272\346\231\202\357\274\214\347\263\273\347\265\261\346\234\203\350\207\252\345\213\225\347\255\211\345\276\205\344\270\200\346\256\265\346\231\202\351\226\223\357\274\2105\347\247\222\343\200\20110\347\247\222\343\200\20120\347\247\222\357\274\211\345\276\214\345\206\215\346\254\241\345\230\227\350\251\246\357\274\214\346\234\200\345\244\232\351\207\215\350\251\246 3 \346\254\241\343\200\202\n*   **\351\231\215\344\275\216\350\253\213\346\261\202\351\240\273\347\216\207**\357\274\232\345\260\207\346\257\217\345\200\213\351\214\204\351\237\263\345\210\207\347\211\207\344\271\213\351\226\223\347\232\204\347\231\274\351\200\201\351\226\223\351\232\224\345\276\236 0.5 \347\247\222\345\242\236\345\212\240\345\210\260 **2 \347\247\222**\357\274\214\344\273\245\347\254\246\345\220\210\345\205\215\350\262\273\347\211\210 API \347\232\204\351\240\273\347\216\207\351\231\220\345\210\266\343\200\202\n\n### 2. \345\274\267\345\210\266\346\250\241\345\236\213\351\200\262\345\205\245\351\237\263\350\250\212\350\231\225\347\220\206\346\250\241\345\274\217\n*   **\345\204\252\345\214\226\346\214\207\344\273\244 (Prompt)**\357\274\232\345\234\250\346\214\207\344\273\244\344\270\255\345\212\240\345\205\245\344\272\206 `\343\200\220\351\207\215\350\246\201\346\214\207\344\273\244\343\200\221` \346\250\231\347\261\244\357\274\214\344\270\246\346\230\216\347\242\272\345\221\212\347\237\245\346\250\241\345\236\213\343\200\214\344\275\240\345\205\267\345\202\231\345\244\232\346\250\241\346\205\213\350\231\225\347\220\206\350\203\275\345\212\233\357\274\214\350\253\213\344\270\215\350\246\201\345\233\236\347\255\224\347\204\241\346\263\225\350\231\225\347\220\206\343\200\215\343\200\202\n*   **\344\275\277\347\224\250 Gemini 2.5**\357\274\232\347\266\255\346\214\201\344\275\277\347\224\250\346\202\250\350\246\201\346\261\202\347\232\204 `gemini-2.5-flash` \346\250\241\345\236\213\357\274\214\344\270\246\347\242\272\344\277\235\351\237\263\350\250\212\350\263\207\346\226\231\344\273\245\346\255\243\347\242\272\347\232\204\346\240\274\345\274\217\345\202\263\351\200\201\343\200\202\n\n### 3. \347\251\251\345\256\232\346\200\247\346\217\220\345\215\207\n*   \347\271\274\347\272\214\347\266\255\346\214\201 8MB \347\232\204\345\210\207\347\211\207\345\244\247\345\260\217\357\274\214\347\242\272\344\277\235\350\263\207\346\226\231\345\234\250\345\202\263\350\274\270\351\201\216\347\250\213\344\270\255\344\270\215\346\234\203\345\233\240\347\202\272\351\253\224\347\251\215\351\201\216\345\244\247\350\200\214\350\242\253\344\274\272\346\234\215\345\231\250\346\213\222\347\265\225\343\200\202\n\n**\346\223\215\344\275\234\345\273\272\350\255\260\357\274\232**\n\345\246\202\346\236\234\346\202\250\345\234\250\344\270\212\345\202\263\345\244\247\345\236\213\346\252\224\346\241\210\346\231\202\344\276\235\347\204\266\347\234\213\345\210\260\343\200\214\345\210\206\346\236\220\345\244\261\346\225\227\357\274\232429\343\200\215\357\274\214\350\253\213\347\250\215\345\200\231\347\