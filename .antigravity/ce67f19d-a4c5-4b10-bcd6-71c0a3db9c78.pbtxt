      name: "create_file"
      arguments_json: "{\"Content\":\"import { useState, useEffect, useRef } from \'react\';\\nimport { GoogleGenAI } from \'@google/genai\';\\nimport ReactMarkdown from \'react-markdown\';\\nimport remarkGfm from \'remark-gfm\';\\nimport { FileText, Loader2, Send, Copy, Check, Mic, Square, Scissors, AlertCircle } from \'lucide-react\';\\n\\nconst ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\\n\\nconst SYSTEM_PROMPT = `\\n# Role\\n\344\275\240\346\230\257\344\270\200\344\275\215\345\260\210\346\245\255\343\200\201\345\205\267\345\202\231\351\253\230\345\272\246\351\202\217\350\274\257\344\270\224\346\225\217\351\212\263\347\232\204\351\253\230\351\232\216\345\260\210\346\241\210\347\247\230\346\233\270\343\200\202\344\275\240\347\232\204\344\273\273\345\213\231\346\230\257\345\260\207\345\206\227\351\225\267\343\200\201\345\217\257\350\203\275\347\274\272\344\271\217\347\265\204\347\271\224\347\232\204\346\234\203\350\255\260\351\200\220\345\255\227\347\250\277\357\274\210\347\264\204 40 \345\210\206\351\220\230\347\232\204\350\250\216\350\253\226\357\274\211\346\210\226\351\214\204\351\237\263\346\221\230\350\246\201\357\274\214\347\262\276\346\272\226\346\217\220\347\205\211\347\202\272\347\265\220\346\247\213\345\214\226\343\200\201\351\253\230\345\217\257\350\256\200\346\200\247\347\232\204\345\260\210\346\245\255\346\234\203\350\255\260\347\264\200\351\214\204 Email\343\200\202\\n\\n# Objective\\n\345\276\236\346\217\220\344\276\233\347\232\204\346\234\203\350\255\260\345\205\247\345\256\271\344\270\255\357\274\214\350\220\203\345\217\226\345\207\272\346\240\270\345\277\203\346\261\272\350\255\260\343\200\201\350\250\216\350\253\226\350\204\210\347\265\241\343\200\201\345\276\205\350\276\246\344\272\213\351\240\205\344\273\245\345\217\212\346\275\233\345\234\250\351\242\250\351\232\252\357\274\214\344\270\246\345\232\264\346\240\274\346\214\211\347\205\247\346\214\207\345\256\232\347\232\204\346\240\274\345\274\217\350\210\207\350\252\236\346\260\243\350\274\270\345\207\272\343\200\202\\n\\n# Guidelines\\n1. \350\263\207\350\250\212\350\220\203\345\217\226\357\274\232\345\277\275\347\225\245\346\234\203\350\255\260\344\270\255\347\232\204\351\226\222\350\201\212\343\200\201\345\206\227\350\251\236\350\264\205\345\255\227\350\210\207\347\204\241\351\227\234\347\267\212\350\246\201\347\232\204\347\264\260\347\257\200\343\200\202\345\260\210\346\263\250\346\226\274\343\200\214\350\252\260\345\234\250\344\273\200\351\272\274\346\231\202\351\226\223\351\273\236\345\211\215\351\234\200\350\246\201\345\256\214\346\210\220\344\273\200\351\272\274\344\272\213\343\200\215\344\273\245\345\217\212\343\200\214\351\201\224\346\210\220\344\272\206\344\273\200\351\272\274\345\205\261\350\255\230\343\200\215\343\200\202\\n2. \350\252\236\346\260\243\350\210\207\351\242\250\346\240\274\357\274\232\344\277\235\346\214\201\345\256\242\350\247\200\343\200\201\345\260\210\346\245\255\343\200\201\347\262\276\347\205\211\347\232\204\345\225\206\345\213\231\350\252\236\346\260\243\343\200\202\\n3. \347\265\220\346\247\213\344\270\200\350\207\264\346\200\247\357\274\232\347\265\225\345\260\215\351\201\265\345\256\210\344\270\213\346\226\271\345\256\232\347\276\251\347\232\204\350\274\270\345\207\272\346\250\241\346\235\277\357\274\214\344\270\215\345\217\257\351\232\250\346\204\217\345\242\236\346\270\233\345\244\247\346\250\231\351\241\214\343\200\202\351\201\207\345\210\260\350\263\207\350\250\212\344\270\215\350\266\263\347\232\204\345\215\200\345\241\212\357\274\214\350\253\213\346\240\271\346\223\232\344\270\212\344\270\213\346\226\207\345\220\210\347\220\206\346\216\250\346\226\267\357\274\214\346\210\226\346\250\231\350\250\230\347\202\272\343\200\214\345\276\205\347\242\272\350\252\215\343\200\215\343\200\202\\n4. \346\264\236\345\257\237\345\212\233\357\274\232\345\234\250\343\200\214\347\247\230\346\233\270\350\247\200\345\257\237\350\210\207\345\273\272\350\255\260\343\200\215\345\215\200\345\241\212\357\274\214\344\275\240\351\234\200\350\246\201\347\231\274\346\217\256 AI \347\232\204\346\264\236\345\257\237\345\212\233\357\274\214\345\276\236\345\260\215\350\251\261\350\204\210\347\265\241\344\270\255\351\273\236\345\207\272\350\267\250\351\203\250\351\226\200\345\215\224\344\275\234\347\232\204\346\275\233\345\234\250\351\242\250\351\232\252\346\210\226\347\256\241\347\220\206\345\261\244\351\235\242\347\232\204\345\203\271\345\200\274\345\273\272\350\255\260\343\200\202\\n\\n# Output Format\\n\350\253\213\345\232\264\346\240\274\344\275\277\347\224\250\344\273\245\344\270\213 Markdown \347\265\220\346\247\213\350\210\207\350\241\250\346\240\274\346\240\274\345\274\217\350\274\270\345\207\272\346\234\203\350\255\260\347\264\200\351\214\204\357\274\232\\n\\n**\346\234\203\350\255\260\345\237\272\346\234\254\350\263\207\350\250\212**\\n* \346\234\203\350\255\260\345\220\215\347\250\261\357\274\232[\350\207\252\345\213\225\350\220\203\345\217\226\346\210\226\347\224\261\344\275\277\347\224\250\350\200\205\346\217\220\344\276\233]\\n* \346\234\203\350\255\260\346\227\245\346\234\237\357\274\232[YYYY\345\271\264MM\346\234\210DD\346\227\245]\\n* \346\234\203\350\255\260\346\231\202\351\226\223\357\274\232[HH:MM AM/PM]\\n* \345\234\260\351\273\236\357\274\232[\347\267\232\344\270\212\346\234\203\350\255\260/\345\257\246\351\253\224\345\234\260\351\273\236]\\n* \350\210\207\346\234\203\344\272\272\345\223\241\357\274\232[\345\210\227\345\207\272\346\211\200\346\234\211\345\217\203\350\210\207\350\200\205\350\210\207\345\205\266\351\203\250\351\226\200]\\n\\n**\344\270\200\343\200\201\346\234\203\350\255\260\351\207\215\351\273\236\346\221\230\350\246\201 (Key Takeaways)**\\n| \351\241\236\345\236\213 | \350\252\252\346\230\216 |\\n| :--- | :--- |\\n| \344\270\273\350\246\201\346\261\272\350\255\260 | [\347\224\250\344\270\200\345\217\245\350\251\261\347\270\275\347\265\220\346\234\203\350\255\260\346\234\200\351\207\215\350\246\201\347\232\204\346\261\272\345\256\232\357\274\214\344\276\213\345\246\202\357\274\232\346\224\276\346\243\204\351\253\230\346\210\220\346\234\254\346\226\271\346\241\210\357\274\214\346\224\271\346\216\241\346\234\254\345\234\260\347\253\257\346\236\266\346\247\213] |\\n| \351\227\234\351\215\265\345\205\261\350\255\230 | [\345\210\227\345\207\272\346\234\200\351\207\215\350\246\201\347\232\204\346\231\202\351\226\223\347\257\200\351\273\236\350\210\207\347\224\242\345\207\272\347\233\256\346\250\231] |\\n| \346\240\270\345\277\203\346\226\271\345\220\221 | [\350\252\252\346\230\216\347\255\226\347\225\245\351\235\242\347\232\204\350\275\211\350\256\212\346\210\226\345\244\247\346\226\271\345\220\221] |\\n\\n**\344\272\214\343\200\201\346\234\203\350\255\260\344\270\273\351\241\214\350\210\207\350\203\214\346\231\257\350\252\252\346\230\216**\\n* \350\203\214\346\231\257 (Background)\357\274\232[\346\242\235\345\210\227\350\252\252\346\230\216\347\202\272\344\275\225\345\217\254\351\226\213\346\255\244\346\234\203\350\255\260\357\274\214\347\233\256\345\211\215\347\232\204\347\227\233\351\273\236\346\230\257\344\273\200\351\272\274]\\n* \347\233\256\346\250\231 (Objective)\357\274\232\\n  1. [\347\233\256\346\250\231\344\270\200]\\n  2. [\347\233\256\346\250\231\344\272\214]\\n  3. [\347\233\256\346\250\231\344\270\211]\\n\\n**\344\270\211\343\200\201\345\220\204\351\240\205\350\255\260\351\241\214\350\250\216\350\253\226\350\210\207\346\261\272\350\255\260 (Discussion & Resolutions)**\\n\343\200\220\350\255\260\351\241\214\344\270\200\357\274\232[\350\220\203\345\217\226\350\255\260\351\241\214\345\220\215\347\250\261]\343\200\221\\n* \350\250\216\350\253\226\351\207\215\351\273\236\357\274\232\\n  * [\351\207\215\351\273\236\344\270\200]\\n  * [\351\207\215\351\273\236\344\272\214]\\n* \346\261\272\350\255\260\344\272\213\351\240\205\357\274\232[\346\230\216\347\242\272\345\210\227\345\207\272\347\265\220\350\253\226\350\210\207\350\262\240\350\262\254\344\272\272]\\n\\n\343\200\220\350\255\260\351\241\214\344\272\214\357\274\232[\350\220\203\345\217\226\350\255\260\351\241\214\345\220\215\347\250\261]\343\200\221\\n* \350\250\216\350\253\226\351\207\215\351\273\236\357\274\232\\n  * [\351\207\215\351\273\236\344\270\200]\\n  * [\351\207\215\351\273\236\344\272\214]\\n* \346\261\272\350\255\260\344\272\213\351\240\205\357\274\232[\346\230\216\347\242\272\345\210\227\345\207\272\347\265\220\350\253\226\350\210\207\350\262\240\350\262\254\344\272\272]\\n\\n**\345\233\233\343\200\201\346\234\203\350\255\260\351\207\215\351\273\236\346\242\235\345\210\227**\\n* \343\200\220\346\261\272\347\255\226\343\200\221[\345\210\227\345\207\272\351\207\215\350\246\201\346\261\272\347\255\226]\\n* \343\200\220\345\205\261\350\255\230\343\200\221[\345\210\227\345\207\272\345\234\230\351\232\212\345\205\261\350\255\230]\\n* \343\200\220\350\277\275\350\271\244\344\272\213\351\240\205\343\200\221[\345\210\227\345\207\272\351\234\200\346\214\201\347\272\214\351\227\234\346\263\250\347\232\204\350\246\217\346\240\274\346\210\226\351\240\205\347\233\256]\\n* \343\200\220\346\212\200\350\241\223\345\210\206\345\267\245\343\200\221[\346\230\216\347\242\272\345\257\253\345\207\272\345\220\204\344\272\272\345\223\241\350\262\240\350\262\254\347\232\204\346\212\200\350\241\223\350\210\207\344\273\273\345\213\231\347\211\210\345\234\226]\\n\\n**\344\272\224\343\200\201\345\276\205\350\276\246\344\272\213\351\240\205\350\277\275\350\271\244\346\270\205\345\226\256 (Action Item Tracking List)**\\n| \351\240\205\346\254\241 | \345\276\205\350\276\246\344\272\213\351\240\205 | \350\262\240\350\262\254\351\203\250\351\226\200/\344\272\272\345\223\241 | \351\240\220\350\250\210\345\256\214\346\210\220\346\227\245\346\234\237 | \345\202\231\350\250\273/\344\272\244\344\273\230\346\250\231\346\272\226 |\\n| :--- | :--- | :--- | :--- | :--- |\\n| 1 | [\345\205\267\351\253\224\344\273\273\345\213\231] | [\350\262\240\350\262\254\344\272\272] | [YYYY/MM/DD] | [\344\272\244\344\273\230\346\250\231\346\272\226] |\\n| 2 | [\345\205\267\351\253\224\344\273\273\345\213\231] | [\350\262\240\350\262\254\344\272\272] | [YYYY/MM/DD] | [\344\272\244\344\273\230\346\250\231\346\272\226] |\\n\\n**\345\205\255\343\200\201\347\247\230\346\233\270\350\247\200\345\257\237\350\210\207\345\273\272\350\255\260 (Secretary\'s Observations & Suggestions)**\\n| \351\241\236\345\236\213 | \345\273\272\350\255\260\345\205\247\345\256\271 |\\n| :--- | :--- |\\n| \347\256\241\347\220\206\350\247\200\345\257\237 | [\345\237\272\346\226\274\346\234\203\350\255\260\345\205\247\345\256\271\357\274\214\346\217\220\345\207\272\346\234\211\345\212\251\346\226\274\347\256\241\347\220\206\346\210\226\350\267\250\351\203\250\351\226\200\345\215\224\344\275\234\347\232\204\346\264\236\345\257\237] |\\n| \346\275\233\345\234\250\351\242\250\351\232\252 | [\346\214\207\345\207\272\346\212\200\350\241\223\343\200\201\346\231\202\347\250\213\346\210\226\350\263\207\346\272\220\344\270\212\345\217\257\350\203\275\351\235\242\350\207\250\347\232\204\351\242\250\351\232\252\357\274\214\344\270\246\347\265\246\345\207\272\345\273\272\350\255\260] |\\n`;\\n\\ndeclare global {\\n  interface Window {\\n    SpeechRecognition: any;\\n    webkitSpeechRecognition: any;\\n  }\\n}\\n\\ninterface Chunk {\\n  id: number;\\n  text: string;\\n  summary?: string;\\n  isAnalyzing: boolean;\\n}\\n\\nexport default function App() {\\n  const [isRecording, setIsRecording] = useState(false);\\n  const [interimText, setInterimText] = useState(\'\');\\n  const [currentChunkText, setCurrentChunkText] = useState(\'\');\\n  const [chunks, setChunks] = useState<Chunk[]>([]);\\n  const [finalReport, setFinalReport] = useState(\'\');\\n  const [isGeneratingFinal, setIsGeneratingFinal] = useState(false);\\n  const [copied, setCopied] = useState(false);\\n  const [errorMsg, setErrorMsg] = useState(\'\');\\n\\n  const recognitionRef = useRef<any>(null);\\n  const isRecordingRef = useRef(false);\\n  const currentChunkRef = useRef(\'\');\\n\\n  useEffect(() => {\\n    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;\\n    if (!SpeechRecognition) {\\n      setErrorMsg(\'\346\202\250\347\232\204\347\200\217\350\246\275\345\231\250\344\270\215\346\224\257\346\217\264\350\252\236\351\237\263\350\276\250\350\255\230\345\212\237\350\203\275\357\274\214\350\253\213\344\275\277\347\224\250 Chrome \347\200\217\350\246\275\345\231\250\343\200\202\');\\n      return;\\n    }\\n\\n    const recognition = new SpeechRecognition();\\n    recognition.continuous = true;\\n    recognition.interimResults = true;\\n    recognition.lang = \'zh-TW\';\\n\\n    recognition.onresult = (event: any) => {\\n      let interim = \'\';\\n      let final = \'\';\\n      for (let i = event.resultIndex; i < event.results.length; ++i) {\\n        if (event.results[i].isFinal) {\\n          final += event.results[i][0].transcript;\\n        } else {\\n          interim += event.results[i][0].transcript;\\n        }\\n      }\\n\\n      setInterimText(interim);\\n\\n      if (final) {\\n        currentChunkRef.current += final + \' \';\\n        setCurrentChunkText(currentChunkRef.current);\\n\\n        // Auto-segment every ~500 characters to ensure we don\'t lose context\\n        if (currentChunkRef.current.length >= 500) {\\n          commitCurrentChunk();\\n        }\\n      }\\n    };\\n\\n    recognition.onerror = (event: any) => {\\n      console.error(\'Speech recognition error\', event.error);\\n      if (event.error === \'not-allowed\') {\\n        setIsRecording(false);\\n        isRecordingRef.current = false;\\n        setErrorMsg(\'\351\272\245\345\205\213\351\242\250\346\254\212\351\231\220\350\242\253\346\213\222\347\265\225\357\274\214\350\253\213\345\205\201\350\250\261\346\254\212\351\231\220\345\276\214\351\207\215\350\251\246\343\200\202\');\\n      }\\n    };\\n\\n    recognition.onend = () => {\\n      if (isRecordingRef.current) {\\n        try {\\n          recognition.start();\\n        } catch (e) {\\n          console.error(\'Failed to restart recognition\', e);\\n        }\\n      }\\n    };\\n\\n    recognitionRef.current = recognition;\\n\\n    return () => {\\n      if (recognitionRef.current) {\\n        recognitionRef.current.stop();\\n      }\\n    };\\n  }, []);\\n\\n  const commitCurrentChunk = async () => {\\n    const textToCommit = currentChunkRef.current.trim();\\n    if (!textToCommit) return;\\n\\n    const newChunkId = Date.now();\\n    const newChunk: Chunk = { id: newChunkId, text: textToCommit, isAnalyzing: true };\\n\\n    setChunks(prev => [...prev, newChunk]);\\n    currentChunkRef.current = \'\';\\n    setCurrentChunkText(\'\');\\n    setInterimText(\'\');\\n\\n    try {\\n      const response = await ai.models.generateContent({\\n        model: \'gemini-3-flash-preview\',\\n        contents: \\\\`\350\253\213\347\260\241\350\246\201\347\270\275\347\265\220\344\273\245\344\270\213\346\234\203\350\255\260\347\211\207\346\256\265\347\232\204\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\357\274\210\350\213\245\347\204\241\345\211\207\347\225\245\351\201\216\357\274\214\344\277\235\346\214\201\347\262\276\347\205\211\357\274\211\357\274\232\\\\\\\\n\\\\\\\\n\\\\${textToCommit}\\\\`,\\n      });\\n      setChunks(prev => prev.map(c => c.id === newChunkId ? { ...c, summary: response.text, isAnalyzing: false } : c));\\n    } catch (e) {\\n      console.error(\'Chunk analysis failed\', e);\\n      setChunks(prev => prev.map(c => c.id === newChunkId ? { ...c, summary: \'\345\210\206\346\236\220\345\244\261\346\225\227\', isAnalyzing: false } : c));\\n    }\\n  };\\n\\n  const toggleRecording = () => {\\n    if (isRecording) {\\n      stopRecording();\\n    } else {\\n      startRecording();\\n    }\\n  };\\n\\n  const startRecording = () => {\\n    setErrorMsg(\'\');\\n    try {\\n      recognitionRef.current?.start();\\n      setIsRecording(true);\\n      isRecordingRef.current = true;\\n    } catch (e) {\\n      console.error(e);\\n    }\\n  };\\n\\n  const stopRecording = () => {\\n    setIsRecording(false);\\n    isRecordingRef.current = false;\\n    recognitionRef.current?.stop();\\n    if (currentChunkRef.current.trim()) {\\n      commitCurrentChunk();\\n    }\\n  };\\n\\n  const generateFinalReport = async () => {\\n    let currentChunks = [...chunks];\\n    \\n    // Commit any remaining text first\\n    if (currentChunkRef.current.trim()) {\\n      const textToCommit = currentChunkRef.current.trim();\\n      const newChunkId = Date.now();\\n      const newChunk: Chunk = { id: newChunkId, text: textToCommit, isAnalyzing: true };\\n      currentChunks.push(newChunk);\\n      \\n      setChunks(currentChunks);\\n      currentChunkRef.current = \'\';\\n      setCurrentChunkText(\'\');\\n      setInterimText(\'\');\\n      \\n      try {\\n        const response = await ai.models.generateContent({\\n          model: \'gemini-3-flash-preview\',\\n          contents: \\\\`\350\253\213\347\260\241\350\246\201\347\270\275\347\265\220\344\273\245\344\270\213\346\234\203\350\255\260\347\211\207\346\256\265\347\232\204\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\357\274\210\350\213\245\347\204\241\345\211\207\347\225\245\351\201\216\357\274\214\344\277\235\346\214\201\347\262\276\347\205\211\357\274\211\357\274\232\\\\\\\\n\\\\\\\\n\\\\${textToCommit}\\\\`,\\n        });\\n        const summary = response.text;\\n        currentChunks = currentChunks.map(c => c.id === newChunkId ? { ...c, summary, isAnalyzing: false } : c);\\n        setChunks(currentChunks);\\n      } catch (e) {\\n        currentChunks = currentChunks.map(c => c.id === newChunkId ? { ...c, summary: \'\345\210\206\346\236\220\345\244\261\346\225\227\', isAnalyzing: false } : c);\\n        setChunks(currentChunks);\\n      }\\n    }\\n\\n    if (currentChunks.length === 0) return;\\n\\n    setIsGeneratingFinal(true);\\n    setFinalReport(\'\');\\n\\n    const contextParts = currentChunks.map((c, i) => \\\\`\343\200\220\345\210\206\346\256\265 \\\\${i + 1}\343\200\221\\\\\\\\n\351\200\220\345\255\227\347\250\277\357\274\232\\\\${c.text}\\\\\\\\n\345\210\235\346\255\245\345\210\206\346\236\220\357\274\232\\\\${c.summary || \'\347\204\241\'}\\\\`).join(\'\\\\\\\\n\\\\\\\\n\');\\n    const prompt = \\\\`\344\273\245\344\270\213\346\230\257\346\234\254\346\254\241\346\234\203\350\255\260\347\232\204\345\256\214\346\225\264\351\200\220\345\255\227\347\250\277\345\210\206\346\256\265\357\274\214\344\273\245\345\217\212AI\351\207\235\345\260\215\345\220\204\345\210\206\346\256\265\347\232\204\345\210\235\346\255\245\350\220\203\345\217\226\351\207\215\351\273\236\343\200\202\350\253\213\347\266\234\345\220\210\351\200\231\344\272\233\350\263\207\350\250\212\357\274\214\347\224\242\345\207\272\346\234\200\347\265\202\347\232\204\347\265\220\346\247\213\345\214\226\346\234\203\350\255\260\347\264\200\351\214\204\343\200\202\\\\\\\\n\\\\\\\\n\\\\${contextParts}\\\\`;\\n\\n    try {\\n      const response = await ai.models.generateContent({\\n        model: \'gemini-3-flash-preview\',\\n        contents: prompt,\\n        config: {\\n          systemInstruction: SYSTEM_PROMPT,\\n        }\\n      });\\n      setFinalReport(response.text || \'\');\\n    } catch (e) {\\n      console.error(e);\\n      setFinalReport(\'\347\224\237\346\210\220\346\234\200\347\265\202\345\240\261\345\221\212\346\231\202\347\231\274\347\224\237\351\214\257\350\252\244\343\200\202\350\253\213\346\252\242\346\237\245\347\266\262\350\267\257\351\200\243\347\267\232\343\200\202\');\\n    } finally {\\n      setIsGeneratingFinal(false);\\n    }\\n  };\\n\\n  const handleCopy = () => {\\n    navigator.clipboard.writeText(finalReport);\\n    setCopied(true);\\n    setTimeout(() => setCopied(false), 2000);\\n  };\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col\\\">\\n      <header className=\\\"bg-white border-b border-slate-200 sticky top-0 z-10 shrink-0\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <div className=\\\"bg-indigo-600 p-2 rounded-lg text-white\\\">\\n              <FileText className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <h1 className=\\\"text-xl font-semibold tracking-tight\\\">\351\253\230\351\232\216\345\260\210\346\241\210\347\247\230\346\233\270 <span className=\\\"text-slate-400 font-normal\\\">| \345\215\263\346\231\202\350\252\236\351\237\263\345\210\206\346\256\265\345\210\206\346\236\220</span></h1>\\n          </div>\\n        </div>\\n      </header>\\n\\n      <main className=\\\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 overflow-hidden\\\">\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-6 h-full\\\">\\n          \\n          {/* Left Column: Recording & Segments */}\\n          <div className=\\\"flex flex-col h-full overflow-hidden\\\">\\n            <div className=\\\"mb-4 flex items-center justify-between shrink-0\\\">\\n              <div>\\n                <h2 className=\\\"text-lg font-medium text-slate-900\\\">\345\215\263\346\231\202\351\214\204\351\237\263\350\210\207\345\210\206\346\256\265\345\210\206\346\236\220</h2>\\n                <p className=\\\"text-sm text-slate-500 mt-1\\\">\346\234\203\350\255\260\351\200\262\350\241\214\344\270\255\357\274\214AI \345\260\207\350\207\252\345\213\225\347\202\272\346\202\250\345\210\206\346\256\265\344\270\246\350\220\203\345\217\226\351\207\215\351\273\236\343\200\202</p>\\n              </div>\\n            </div>\\n            \\n            <div className=\\\"flex items-center gap-2 mb-4 shrink-0\\\">\\n              <button \\n                onClick={toggleRecording} \\n                className={\\\\`flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-white transition-colors \\\\${isRecording ? \'bg-red-500 hover:bg-red-600 shadow-red-200\' : \'bg-indigo-600 hover:bg-indigo-700 shadow-indigo-200\'} shadow-sm\\\\`}\\n              >\\n                {isRecording ? <><Square className=\\\"w-4 h-4\\\" /> \345\201\234\346\255\242\351\214\204\351\237\263</> : <><Mic className=\\\"w-4 h-4\\\" /> \351\226\213\345\247\213\351\214\204\351\237\263</>}\\n              </button>\\n              <button \\n                onClick={commitCurrentChunk} \\n                disabled={!currentChunkText.trim() && !interimText.trim()} \\n                className=\\\"flex items-center gap-2 px-4 py-2 rounded-lg font-medium bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 disabled:opacity-50 transition-colors shadow-sm\\\"\\n              >\\n                <Scissors className=\\\"w-4 h-4\\\" /> \346\211\213\345\213\225\345\210\206\346\256\265\\n              </button>\\n            </div>\\n            \\n            {errorMsg && (\\n              <div className=\\\"mb-4 p-3 bg-red-50 text-red-700 rounded-lg flex items-center gap-2 text-sm shrink-0\\\">\\n                <AlertCircle className=\\\"w-4 h-4\\\" /> {errorMsg}\\n              </div>\\n            )}\\n\\n            {/* Current Segment */}\\n            <div className=\\\"mb-4 p-4 bg-white border border-indigo-100 rounded-xl shadow-sm shrink-0\\\">\\n              <h3 className=\\\"text-sm font-medium text-indigo-900 mb-2 flex items-center gap-2\\\">\\n                <span className=\\\"relative flex h-2.5 w-2.5\\\">\\n                  {isRecording && <span className=\\\"animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75\\\"></span>}\\n                  <span className={\\\\`relative inline-flex rounded-full h-2.5 w-2.5 \\\\${isRecording ? \'bg-indigo-500\' : \'bg-slate-300\'}\\\\`}></span>\\n                </span>\\n                \347\225\266\345\211\215\346\2