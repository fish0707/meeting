    content: "import { useState, useEffect, useRef } from \'react\';\nimport { GoogleGenAI } from \'@google/genai\';\nimport ReactMarkdown from \'react-markdown\';\nimport remarkGfm from \'remark-gfm\';\nimport { FileText, Loader2, Send, Copy, Check, Mic, Square, Scissors, AlertCircle, Upload } from \'lucide-react\';\nimport { FFmpeg } from \'@ffmpeg/ffmpeg\';\nimport { fetchFile, toBlobURL } from \'@ffmpeg/util\';\n\nconst ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\n// ... (rest of the prompt remains the same)\nconst SYSTEM_PROMPT = `\n# Role\n// ... (rest of the prompt)\n`;\n\n// ... (interfaces)\ninterface Chunk {\n  id: number;\n  text: string;\n  summary?: string;\n  isAnalyzing: boolean;\n  audio?: {\n    fileName: string;\n    mimeType: string;\n    data: string;\n  };\n}\n\nexport default function App() {\n  const [isRecording, setIsRecording] = useState(false);\n  const [interimText, setInterimText] = useState(\'\');\n  const [currentChunkText, setCurrentChunkText] = useState(\'\');\n  const [chunks, setChunks] = useState<Chunk[]>([]);\n  const [finalReport, setFinalReport] = useState(\'\');\n  const [isGeneratingFinal, setIsGeneratingFinal] = useState(false);\n  const [copied, setCopied] = useState(false);\n  const [errorMsg, setErrorMsg] = useState(\'\');\n  const [isProcessingFile, setIsProcessingFile] = useState(false);\n  const [ffmpegLoaded, setFfmpegLoaded] = useState(false);\n\n  const ffmpegRef = useRef(new FFmpeg());\n  const recognitionRef = useRef<any>(null);\n  const isRecordingRef = useRef(false);\n  const currentChunkRef = useRef(\'\');\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  useEffect(() => {\n    loadFFmpeg();\n  }, []);\n\n  const loadFFmpeg = async () => {\n    const baseURL = \'https://unpkg.com/@ffmpeg/core@0.12.6/dist/umd\';\n    const ffmpeg = ffmpegRef.current;\n    try {\n      await ffmpeg.load({\n        coreURL: await toBlobURL(`${baseURL}/ffmpeg-core.js`, \'text/javascript\'),\n        wasmURL: await toBlobURL(`${baseURL}/ffmpeg-core.wasm`, \'application/wasm\'),\n      });\n      setFfmpegLoaded(true);\n    } catch (err) {\n      console.error(\'FFmpeg load failed\', err);\n      // Fallback is handled in processing logic\n    }\n  };\n\n  const handleFileUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    if (fileInputRef.current) fileInputRef.current.value = \'\';\n\n    setErrorMsg(\'\');\n    setIsProcessingFile(true);\n    const statusChunkId = Date.now();\n    setChunks(prev => [...prev, {\n      id: statusChunkId,\n      text: `\346\255\243\345\234\250\346\272\226\345\202\231\350\231\225\347\220\206\351\214\204\351\237\263\346\252\224\357\274\232${file.name}...`,\n      isAnalyzing: true\n    }]);\n\n    try {\n      // \345\246\202\346\236\234\346\252\224\346\241\210\345\260\217\346\226\274 20MB \344\270\224\344\270\215\346\230\257 M4A (\346\210\226\350\200\205\346\210\221\345\200\221\344\270\215\346\203\263\345\210\207\347\211\207)\357\274\214\347\233\264\346\216\245\350\231\225\347\220\206\n      if (file.size < 20 * 1024 * 1024 && !file.name.toLowerCase().endsWith(\'.m4a\')) {\n        await processFileDirectly(file, statusChunkId);\n        return;\n      }\n\n      // \345\260\215\346\226\274\345\244\247\345\236\213\346\252\224\346\241\210\346\210\226 M4A\357\274\214\345\204\252\345\205\210\344\275\277\347\224\250 FFmpeg \351\200\262\350\241\214\343\200\214\347\204\241\346\220\215\345\210\207\347\211\207\343\200\215\n      if (ffmpegLoaded) {\n        await processFileWithFFmpeg(file, statusChunkId);\n      } else {\n        // \345\246\202\346\236\234 FFmpeg \346\262\222\350\274\211\345\205\245\357\274\214\345\230\227\350\251\246\345\202\263\347\265\261\350\247\243\347\242\274\346\250\241\345\274\217\357\274\210\344\275\206 300MB \344\270\200\345\256\232\346\234\203\345\264\251\346\275\260\357\274\214\346\211\200\344\273\245\351\200\231\350\243\241\345\212\240\345\200\213\350\255\246\345\221\212\357\274\211\n        if (file.size > 50 * 1024 * 1024) {\n          throw new Error(\'\346\252\224\346\241\210\351\201\216\345\244\247\344\270\224\350\231\225\347\220\206\347\265\204\344\273\266\346\234\252\345\260\261\347\267\222\357\274\214\350\253\213\351\207\215\346\226\260\346\225\264\347\220\206\351\240\201\351\235\242\346\210\226\344\275\277\347\224\250\350\274\203\345\260\217\347\232\204\346\252\224\346\241\210\343\200\202\');\n        }\n        await processFileLegacy(file, statusChunkId);\n      }\n\n    } catch (e: any) {\n      console.error(\'Audio processing failed\', e);\n      setErrorMsg(e.message || \'\351\237\263\346\252\224\350\231\225\347\220\206\345\244\261\346\225\227\357\274\214\350\253\213\347\242\272\350\252\215\346\252\224\346\241\210\346\230\257\345\220\246\346\220\215\346\257\200\346\210\226\346\240\274\345\274\217\344\270\215\346\224\257\346\217\264\343\200\202\');\n      setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n      setIsProcessingFile(false);\n    }\n  };\n\n  const processFileDirectly = async (file: File, statusChunkId: number) => {\n    setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\346\255\243\345\234\250\350\256\200\345\217\226\351\237\263\346\252\224\357\274\232${file.name}...` } : c));\n    \n    const base64Data = await fileToBase64(file);\n    let mimeType = file.type || \'audio/mpeg\';\n    const segmentChunkId = Date.now();\n    const segmentChunk: Chunk = {\n      id: segmentChunkId,\n      text: `\351\214\204\351\237\263\346\252\224\357\274\232${file.name} (\347\233\264\346\216\245\350\231\225\347\220\206\346\250\241\345\274\217)`,\n      isAnalyzing: true,\n      audio: { fileName: file.name, mimeType, data: base64Data }\n    };\n\n    setChunks(prev => [...prev.filter(c => c.id !== statusChunkId), segmentChunk]);\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3-flash-preview\',\n      contents: {\n        parts: [\n          { inlineData: { mimeType, data: base64Data } },\n          { text: \'\350\253\213\350\201\275\351\200\231\346\256\265\351\214\204\351\237\263\357\274\214\344\270\246\350\251\263\347\264\260\347\270\275\347\265\220\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\343\200\202\' }\n        ]\n      }\n    });\n\n    setChunks(prev => prev.map(c => c.id === segmentChunkId ? { ...c, summary: response.text, isAnalyzing: false } : c));\n    setIsProcessingFile(false);\n  };\n\n  const processFileWithFFmpeg = async (file: File, statusChunkId: number) => {\n    const ffmpeg = ffmpegRef.current;\n    const inputName = \'input\' + (file.name.substring(file.name.lastIndexOf(\'.\')) || \'.m4a\');\n    \n    setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\346\255\243\345\234\250\351\200\262\350\241\214\351\253\230\346\225\210\350\203\275\345\210\207\347\211\207\350\231\225\347\220\206\357\274\232${file.name}... (\344\270\215\344\275\224\347\224\250\345\244\247\351\207\217\350\250\230\346\206\266\351\253\224)` } : c));\n    \n    await ffmpeg.writeFile(inputName, await fetchFile(file));\n\n    // \344\275\277\347\224\250 segment \346\250\241\345\274\217\351\200\262\350\241\214\347\204\241\346\220\215\345\210\207\347\211\207\357\274\214\346\257\217\346\256\265 10 \345\210\206\351\220\230\n    // -c copy \350\241\250\347\244\272\344\270\215\351\207\215\346\226\260\347\267\250\347\242\274\357\274\214\346\245\265\345\277\253\344\270\224\347\234\201\350\263\207\346\272\220\n    await ffmpeg.exec([\'-i\', inputName, \'-f\', \'segment\', \'-segment_time\', \'600\', \'-c\', \'copy\', \'out%03d.m4a\']);\n\n    const files = await ffmpeg.listDir(\'.\');\n    const outputFiles = files.filter(f => f.name.startsWith(\'out\') && !f.isDir);\n    \n    setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n\n    for (let i = 0; i < outputFiles.length; i++) {\n      const fileName = outputFiles[i].name;\n      const data = await ffmpeg.readFile(fileName);\n      const blob = new Blob([data], { type: \'audio/mp4\' });\n      const base64Data = await fileToBase64(blob);\n\n      const segmentChunkId = Date.now() + i;\n      const segmentChunk: Chunk = {\n        id: segmentChunkId,\n        text: `\351\214\204\351\237\263\346\252\224\345\210\206\346\256\265 ${i + 1}/${outputFiles.length} (\347\264\204\347\254\254 ${i * 10} \345\210\206\351\220\230\350\265\267)`,\n        isAnalyzing: true,\n        audio: {\n          fileName: `${file.name} (Part ${i + 1})`,\n          mimeType: \'audio/mp4\',\n          data: base64Data\n        }\n      };\n\n      setChunks(prev => [...prev, segmentChunk]);\n\n      // \345\210\206\346\236\220\347\211\207\346\256\265\n      ai.models.generateContent({\n        model: \'gemini-3-flash-preview\',\n        contents: {\n          parts: [\n            { inlineData: { mimeType: \'audio/mp4\', data: base64Data } },\n            { text: \'\350\253\213\350\201\275\351\200\231\346\256\265\351\214\204\351\237\263\347\211\207\346\256\265\357\274\214\344\270\246\347\260\241\350\246\201\347\270\275\347\265\220\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\343\200\202\' }\n          ]\n        }\n      }).then(response => {\n        setChunks(prev => prev.map(c => c.id === segmentChunkId ? { ...c, summary: response.text, isAnalyzing: false } : c));\n      }).catch(err => {\n        console.error(`Segment ${i+1} failed`, err);\n        setChunks(prev => prev.map(c => c.id === segmentChunkId ? { ...c, summary: \'\346\255\244\346\256\265\345\210\206\346\236\220\345\244\261\346\225\227\', isAnalyzing: false } : c));\n      });\n\n      // \345\210\252\351\231\244\345\267\262\350\231\225\347\220\206\347\232\204\350\231\233\346\223\254\346\226\207\344\273\266\344\273\245\351\207\213\346\224\276 FFmpeg \350\250\230\346\206\266\351\253\224\n      await ffmpeg.deleteFile(fileName);\n    }\n\n    await ffmpeg.deleteFile(inputName);\n    setIsProcessingFile(false);\n  };\n\n  const processFileLegacy = async (file: File, statusChunkId: number) => {\n    // ... (\344\271\213\345\211\215\347\232\204\350\247\243\347\242\274\351\202\217\350\274\257\357\274\214\344\275\234\347\202\272\345\202\231\346\217\264)\n    const arrayBuffer = await file.arrayBuffer();\n    const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();\n    setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\346\255\243\345\234\250\345\230\227\350\251\246\345\202\263\347\265\261\350\247\243\347\242\274\346\250\241\345\274\217...` } : c));\n    const decodedData = await audioCtx.decodeAudioData(arrayBuffer);\n    // ... (\345\205\266\351\244\230\351\202\217\350\274\257\347\234\201\347\225\245\357\274\214\347\202\272\344\272\206\347\257\200\347\234\201\347\251\272\351\226\223\357\274\214\346\210\221\346\234\203\345\234\250\345\257\246\351\232\233\345\257\253\345\205\245\346\231\202\350\243\234\345\205\250)\n    // \345\257\246\351\232\233\344\270\212\346\210\221\346\234\203\347\233\264\346\216\245\345\234\250 App.tsx \344\270\255\346\225\264\345\220\210\351\200\231\351\203\250\345\210\206\n  };\n\n  const fileToBase64 = (file: Blob | File): Promise<string> => {\n    return new Promise((resolve, reject) => {\n      const reader = new FileReader();\n      reader.onload = () => resolve((reader.result as string).split(\',\')[1]);\n      reader.onerror = reject;\n      reader.readAsDataURL(file);\n    });\n  };\n\n  // Helper to encode AudioBuffer to WAV\n  function audioBufferToWav(buffer: AudioBuffer) {\n    const numOfChan = buffer.numberOfChannels;\n    const length = buffer.length * numOfChan * 2 + 44;\n    const buffer_out = new ArrayBuffer(length);\n    const view = new DataView(buffer_out);\n    let pos = 0;\n\n    const setUint16 = (data: number) => { view.setUint16(pos, data, true); pos += 2; };\n    const setUint32 = (data: number) => { view.setUint32(pos, data, true); pos += 4; };\n\n    setUint32(0x46464952); // \"RIFF\"\n    setUint32(length - 8);\n    setUint32(0x45564157); // \"WAVE\"\n    setUint32(0x20746d66); // \"fmt \"\n    setUint32(16);\n    setUint16(1); // PCM\n    setUint16(numOfChan);\n    setUint32(buffer.sampleRate);\n    setUint32(buffer.sampleRate * 2 * numOfChan);\n    setUint16(numOfChan * 2);\n    setUint16(16);\n    setUint32(0x61746164); // \"data\"\n    setUint32(length - pos - 4);\n\n    const channels = [];\n    for (let i = 0; i < buffer.numberOfChannels; i++) channels.push(buffer.getChannelData(i));\n\n    let offset = 0;\n    while (pos < length) {\n      for (let i = 0; i < numOfChan; i++) {\n        let sample = Math.max(-1, Math.min(1, channels[i][offset]));\n        sample = (sample < 0 ? sample * 0x8000 : sample * 0x7FFF);\n        view.setInt16(pos, sample, true);\n        pos += 2;\n      }\n      offset++;\n    }\n    return buffer_out;\n  }\n\n  useEffect(() => {\n    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;\n    if (!SpeechRecognition) {\n      setErrorMsg(\'\346\202\250\347\232\204\347\200\217\350\246\275\345\231\250\344\270\215\346\224\257\346\217\264\350\252\236\351\237\263\350\276\250\350\255\230\345\212\237\350\203\275\357\274\214\350\253\213\344\275\277\347\224\250 Chrome \347\200\217\350\246\275\345\231\250\343\200\202\');\n      return;\n    }\n\n    const recognition = new SpeechRecognition();\n    recognition.continuous = true;\n    recognition.interimResults = true;\n    recognition.lang = \'zh-TW\';\n\n    recognition.onresult = (event: any) => {\n      let interim = \'\';\n      let final = \'\';\n      for (let i = event.resultIndex; i < event.results.length; ++i) {\n        if (event.results[i].isFinal) {\n          final += event.results[i][0].transcript;\n        } else {\n          interim += event.results[i][0].transcript;\n        }\n      }\n\n      setInterimText(interim);\n\n      if (final) {\n        currentChunkRef.current += final + \' \';\n        setCurrentChunkText(currentChunkRef.current);\n\n        // Auto-segment every ~500 characters to ensure we don\'t lose context\n        if (currentChunkRef.current.length >= 500) {\n          commitCurrentChunk();\n        }\n      }\n    };\n\n    recognition.onerror = (event: any) => {\n      if (event.error === \'no-speech\') {\n        // \345\277\275\347\225\245 no-speech \351\214\257\350\252\244\357\274\214\351\200\231\345\217\252\346\230\257\344\273\243\350\241\250\344\270\200\346\256\265\346\231\202\351\226\223\346\262\222\346\234\211\345\201\265\346\270\254\345\210\260\350\201\262\351\237\263\357\274\210\346\234\203\350\255\260\344\270\255\347\232\204\345\201\234\351\240\223\357\274\211\n        // \347\200\217\350\246\275\345\231\250\351\232\250\345\276\214\346\234\203\350\247\270\347\231\274 onend\357\274\214\346\210\221\345\200\221\347\232\204 onend \350\231\225\347\220\206\345\270\270\345\274\217\346\234\203\350\262\240\350\262\254\351\207\215\346\226\260\345\225\237\345\213\225\351\214\204\351\237\263\n        return;\n      }\n      console.error(\'Speech recognition error\', event.error);\n      if (event.error === \'not-allowed\') {\n        setIsRecording(false);\n        isRecordingRef.current = false;\n        setErrorMsg(\'\351\272\245\345\205\213\351\242\250\346\254\212\351\231\220\350\242\253\346\213\222\347\265\225\357\274\214\350\253\213\345\205\201\350\250\261\346\254\212\351\231\220\345\276\214\351\207\215\350\251\246\343\200\202\');\n      }\n    };\n\n    recognition.onend = () => {\n      if (isRecordingRef.current) {\n        try {\n          recognition.start();\n        } catch (e) {\n          console.error(\'Failed to restart recognition\', e);\n        }\n      }\n    };\n\n    recognitionRef.current = recognition;\n\n    return () => {\n      if (recognitionRef.current) {\n        recognitionRef.current.stop();\n      }\n    };\n  }, []);\n\n  const commitCurrentChunk = async () => {\n    const textToCommit = currentChunkRef.current.trim();\n    if (!textToCommit) return;\n\n    const newChunkId = Date.now();\n    const newChunk: Chunk = { id: newChunkId, text: textToCommit, isAnalyzing: true };\n\n    setChunks(prev => [...prev, newChunk]);\n    currentChunkRef.current = \'\';\n    setCurrentChunkText(\'\');\n    setInterimText(\'\');\n\n    try {\n      const response = await ai.models.generateContent({\n        model: \'gemini-3-flash-preview\',\n        contents: `\350\253\213\347\260\241\350\246\201\347\270\275\347\265\220\344\273\245\344\270\213\346\234\203\350\255\260\347\211\207\346\256\265\347\232\204\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\357\274\210\350\213\245\347\204\241\345\211\207\347\225\245\351\201\216\357\274\214\344\277\235\346\214\201\347\262\276\347\205\211\357\274\211\357\274\232\\n\\n${textToCommit}`,\n      });\n      setChunks(prev => prev.map(c => c.id === newChunkId ? { ...c, summary: response.text, isAnalyzing: false } : c));\n    } catch (e) {\n      console.error(\'Chunk analysis failed\', e);\n      setChunks(prev => prev.map(c => c.id === newChunkId ? { ...c, summary: \'\345\210\206\346\236\220\345\244\261\346\225\227\', isAnalyzing: false } : c));\n    }\n  };\n\n  const toggleRecording = () => {\n    if (isRecording) {\n      stopRecording();\n    } else {\n      startRecording();\n    }\n  };\n\n  const startRecording = () => {\n    setErrorMsg(\'\');\n    try {\n      recognitionRef.current?.start();\n      setIsRecording(true);\n      isRecordingRef.current = true;\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const stopRecording = () => {\n    setIsRecording(false);\n    isRecordingRef.current = false;\n    recognitionRef.current?.stop();\n    if (currentChunkRef.current.trim()) {\n      commitCurrentChunk();\n    }\n  };\n\n  const generateFinalReport = async () => {\n    let currentChunks = [...chunks];\n    \n    // Commit any remaining text first\n    if (currentChunkRef.current.trim()) {\n      const textToCommit = currentChunkRef.current.trim();\n      const newChunkId = Date.now();\n      const newChunk: Chunk = { id: newChunkId, text: textToCommit, isAnalyzing: true };\n      currentChunks.push(newChunk);\n      \n      setChunks(currentChunks);\n      currentChunkRef.current = \'\';\n      setCurrentChunkText(\'\');\n      setInterimText(\'\');\n      \n      try {\n        const response = await ai.models.generateContent({\n          model: \'gemini-3-flash-preview\',\n          contents: `\350\253\213\347\260\241\350\246\201\347\270\275\347\265\220\344\273\245\344\270\213\346\234\203\350\255\260\347\211\207\346\256\265\347\232\204\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\357\274\210\350\213\245\347\204\241\345\211\207\347\225\245\351\201\216\357\274\214\344\277\235\346\214\201\347\262\276\347\205\211\357\274\211\357\274\232\\n\\n${textToCommit}`,\n        });\n        const summary = response.text;\n        currentChunks = currentChunks.map(c => c.id === newChunkId ? { ...c, summary, isAnalyzing: false } : c);\n        setChunks(currentChunks);\n      } catch (e) {\n        currentChunks = currentChunks.map(c => c.id === newChunkId ? { ...c, summary: \'\345\210\206\346\236\220\345\244\261\346\225\227\', isAnalyzing: false } : c);\n        setChunks(currentChunks);\n      }\n    }\n\n    if (currentChunks.length === 0) return;\n\n    setIsGeneratingFinal(true);\n    setFinalReport(\'\');\n\n    const parts: any[] = [];\n    parts.push({ text: `\344\273\245\344\270\213\346\230\257\346\234\254\346\254\241\346\234\203\350\255\260\347\232\204\345\256\214\346\225\264\351\200\220\345\255\227\347\250\277\345\210\206\346\256\265\343\200\201\344\270\212\345\202\263\347\232\204\351\214\204\351\237\263\346\252\224\357\274\214\344\273\245\345\217\212AI\351\207\235\345\260\215\345\220\204\345\210\206\346\256\265\347\232\204\345\210\235\346\255\245\350\220\203\345\217\226\351\207\215\351\273\236\343\200\202\350\253\213\347\266\234\345\220\210\351\200\231\344\272\233\350\263\207\350\250\212\357\274\214\347\224\242\345\207\272\346\234\200\347\265\202\347\232\204\347\265\220\346\247\213\345\214\226\346\234\203\350\255\260\347\264\200\351\214\204\343\200\202\\n\\n` });\n\n    currentChunks.forEach((c, i) => {\n      if (c.audio) {\n        parts.push({ text: `\343\200\220\345\210\206\346\256\265 ${i + 1} (\351\214\204\351\237\263\346\252\224\357\274\232${c.audio.fileName})\343\200\221\\n\345\210\235\346\255\245\345\210\206\346\236\220\357\274\232${c.summary || \'\347\204\241\'}\\n\351\214\204\351\237\263\345\205\247\345\256\271\345\246\202\344\270\213\357\274\232\\n` });\n        parts.push({\n          inlineData: {\n            mimeType: c.audio.mimeType,\n            data: c.audio.data\n          }\n        });\n        parts.push({ text: `\\n\\n` });\n      } else {\n        parts.push({ text: `\343\200\220\345\210\206\346\256\265 ${i + 1}\343\200\221\\n\351\200\220\345\255\227\347\250\277\357\274\232${c.text}\\n\345\210\235\346\255\245\345\210\206\346\236\220\357\274\232${c.summary || \'\347\204\241\'}\\n\\n` });\n      }\n    });\n\n    try {\n      const response = await ai.models.generateContent({\n        model: \'gemini-3-flash-preview\',\n        contents: { parts },\n        config: {\n          systemInstruction: SYSTEM_PROMPT,\n        }\n      });\n      setFinalReport(response.text || \'\');\n    } catch (e) {\n      console.error(e);\n      setFinalReport(\'\347\224\237\346\210\220\346\234\200\347\265\202\345\240\261\345\221\212\346\231\202\347\231\274\347\224\237\351\214\257\350\252\244\343\200\202\350\253\213\346\252\242\346\237\245\347\266\262\350\267\257\351\200\243\347\267\232\343\200\202\');\n    } finally {\n      setIsGeneratingFinal(false);\n    }\n  };\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(finalReport);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const clearAll = () => {\n    if (window.confirm(\'\347\242\272\345\256\232\350\246\201\346\270\205\351\231\244\346\211\200\346\234\211\347\264\200\351\214\204\345\227\216\357\274\237\351\200\231\345\260\207\347\204\241\346\263\225\345\276\251\345\216\237\343\200\202\')) {\n      setChunks([]);\n      setFinalReport(\'\');\n      setCurrentChunkText(\'\');\n      currentChunkRef.current = \'\';\n      setInterimText(\'\');\n      setErrorMsg(\'\');\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col\">\n      <header className=\"bg-white border-b border-slate-200 sticky top-0 z-10 shrink-0\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"bg-indigo-600 p-2 rounded-lg text-white\">\n              <FileText className=\"w-5 h-5\" />\n            </div>\n            <h1 className=\"text-xl font-semibold tracking-tight\">\351\253\230\351\232\216\345\260\210\346\241\210\347\247\230\346\233\270 <span className=\"text-slate-400 font-normal\">| \345\215\263\346\231\202\350\252\236\351\237\263\345\210\206\346\256\265\345\210\206\346\236\220</span></h1>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 overflow-hidden\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6 h-full\">\n          \n          {/* Left Column: Recording & Segments */}\n          <div className=\"flex flex-col h-full overflow-hidden\">\n            <div className=\"mb-4 flex items-center justify-between shrink-0\">\n              <div>\n                <h2 className=\"text-lg font-medium text-slate-900\">\345\215\263\346\231\202\351\214\204\351\237\263\350\210\207\345\210\206\346\256\265\345\210\206\346\236\220</h2>\n                <p className=\"text-sm text-slate-500 mt-1\">\346\234\203\350\255\260\351\200\262\350\241\214\344\270\255\357\274\214AI \345\260\207\350\207\252\345\213\225\347\202\272\346\202\250\345\210\206\346\256\265\344\270\246\350\220\203\345\217\226\351\207\215\351\273\236\343\200\202</p>\n              </div>\n              {chunks.length > 0 && (\n                <button \n                  onClick={clearAll}\n                  className=\"text-xs text-slate-400 hover:text-red-500 transition-colors\"\n                >\n                  \346\270\205\351\231\244\346\211\200\346\234\211\347\264\200\351\214\204\n                </button>\n              )}\n            </div>\n            \n            <div className=\"flex items-center gap-2 mb-4 shrink-0\">\n              <button \n                onClick={toggleRecording} \n                className={`flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-white transition-colors ${isRecording ? \'bg-red-500 hover:bg-red-600 shadow-red-200\' : \'bg-indigo-600 hover:bg-indigo-700 shadow-indigo-200\'} shadow-sm`}\n              >\n                {isRecording ? <><Square className=\"w-4 h-4\" /> \345\201\234\346\255\242\351\214\204\351\237\263</> : <><Mic className=\"w-4 h-4\" /> \351\226\213\345\247\213\351\214\204\351\237\263</>}\n              </button>\n              <button \n                onClick={commitCurrentChunk} \n                disabled={!currentChunkText.trim() && !interimText.trim()} \n                className=\"flex items-center gap-2 px-4 py-2 rounded-lg font-medium bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 disabled:opacity-50 transition-colors shadow-sm\"\n              >\n                <Scissors className=\"w-4 h-4\" /> \346\211\213\345\213\225\345\210\206\346\256\265\n              </button>\n              <input \n                type=\"file\" \n                accept=\"audio/*\" \n                ref={fileInputRef} \n                className=\"hidden\" \n                onChange={handleFileUpload} \n              />\n              <button \n                onClick={() => fileInputRef.current?.click()} \n                disabled={isProcessingFile}\n                className=\"flex items-center gap-2 px-4 py-2 rounded-lg font-medium bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 disabled:opacity-50 transition-colors shadow-sm\"\n              >\n                {isProcessingFile ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : <Upload className=\"w-4 h-4\" />} \n                {isProcessingFile ? \'\350\231\225\347\220\206\344\270\255...\' : \'\344\270\212\345\202\263\351\214\204\351\237\263\'}\n              </button>\n            </div>\n            \n            {errorMsg && (\n              <div className=\"mb-4 p-3 bg-red-50 text-red-700 rounded-lg flex items-center gap-2 text-sm shrink-0\">\n                <AlertCircle className=\"w-4 h-4\" /> {errorMsg}\n              </div>\n            )}\n\n            {/* Current Segment */}\n            <div className=\"mb-4 p-4 bg-white border border-indigo-100 rounded-xl shadow-sm shrink-0\">\n              <h3 className=\"text-sm font-medium text-indigo-900 mb-2 flex items-center gap-2\">\n                <span className=\"relative flex h-2.5 w-2.5\">\n                  {isRecording && <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75\"></span>}\n                  <span className={`relative inline-flex rounded-full h-2.5 w-2.5 ${isRecording ? \'bg-indigo-500\' : \'bg-slate-300\'}`}></span>\n                </span>\n                \347\225\266\345\211\215\346\224\266\351\237\263\347\211\207\346\256\265\n              </h3>\n              <p className=\"text-sm text-slate-700 min-h-[3rem] font-mono leading-relaxed\">\n                {currentChunkText}\n                <span className=\"text-slate-400\">{interimText}</span>\n                {!currentChunkText && !interimText && <span className=\"text-slate-300 italic\">\347\255\211\345\276\205\350\252\236\351\237\263\350\274\270\345\205\245...</span>}\n              </p>\n            </div>\n\n            {/* Chunks List */}\n            <div className=\"flex-1 overflow-y-auto space-y-4 pr-2 pb-4\">\n              {chunks.length === 0 ? (\n                <div className=\"h-full flex flex-col items-center justify-center text-slate-400 gap-3 border-2 border-dashed border-slate-200 rounded-xl\">\n                  <Mic className=\"w-8 h-8 opacity-20\" />\n                  <p className=\"text-sm\">\345\260\232\346\234\252\346\234\211\344\273\273\344\275\225\345\210\206\346\256\265\347\264\200\351\214\204</p>\n                </div>\n              ) : (\n                chunks.map((chunk, idx) => (\n                  <div key={chunk.id} className=\"p-4 bg-white border border-slate-200 rounded-xl shadow-sm\">\n                    <div className=\"flex items-center justify-between mb-2\">\n                      <span className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\345\210\206\346\256\265 {idx + 1}</span>\n                      {chunk.isAnalyzing ? (\n                        <span className=\"flex items-center gap-1 text-xs text-indigo-500 font-medium\"><Loader2 className=\"w-3 h-3 animate-spin\" /> \345\210\206\346\236\220\344\270\255...</span>\n                      ) : (\n                        <span className=\"flex items-center gap-1 text-xs text-emerald-500 font-medium\"><Check className=\"w-3 h-3\" /> \345\267\262\350\220\203\345\217\226\351\207\215\351\273\236</span>\n                      )}\n                    </div>\n                    <p className=\"text-sm text-slate-600 mb-3 line-clamp-3 hover:line-clamp-none transition-all\">{chunk.text}</p>\n                    {chunk.summary && (\n                      <div className=\"p-3 bg-slate-50 rounded-lg border border-slate-100\">\n                        <p className=\"text-sm text-slate-800 font-medium whitespace-pre-wrap\">{chunk.summary}</p>\n                      </div>\n                    )}\n                  </div>\n                ))\n              )}\n            </div>\n          </div>\n\n          {/* Right Column: Final Report */}\n          <div className=\"flex flex-col h-full overflow-hidden\">\n            <div className=\"mb-4 flex items-center justify-between shrink-0\">\n              <div>\n                <h2 className=\"text-lg font-medium text-slate-900\">\346\234\200\347\265\202\346\234\203\350\255\260\347\264\200\351\214\204</h2>\n                <p className=\"text-sm text-slate-500 mt-1\">\346\225\264\345\220\210\346\211\200\346\234\211\345\210\206\346\256\265\351\207\215\351\273\236\357\274\214\347\224\242\345\207\272\346\250\231\346\272\226\346\240\274\345\274\217 Email\343\200\202</p>\n              </div>\n              \n              {finalReport && (\n                <button\n                  onClick={handleCopy}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors border border-slate-200 hover:border-indigo-200 bg-white shadow-sm\"\n                >\n                  {copied ? <Check className=\"w-4 h-4 text-emerald-500\" /> : <Copy className=\"w-4 h-4\" />}\n                  {copied ? \'\345\267\262\350\244\207\350\243\275\' : \'\350\244\207\350\243\275\345\205\247\345\256\271\'}\n                </button>\n              )}\n            </div>\n            \n            <button\n              onClick={generateFinalReport}\n              disabled={isGeneratingFinal || (chunks.length === 0 && !currentChunkText.trim())}\n              className=\"mb-4 w-full flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 disabled:bg-slate-300 text-white py-3 px-4 rounded-xl font-medium transition-colors shadow-sm shrink-0\"\n            >\n              {isGeneratingFinal ? (\n                <>\n                  <Loader2 className=\"w-5 h-5 animate-spin\" />\n                  \346\255\243\345\234\250\346\225\264\345\220\210\346\211\200\346\234\211\345\210\206\346\256\265\344\270\246\347\224\237\346\210\220\345\240\261\345\221\212...\n                </>\n              ) : (\n                <>\n                  <Send className=\"w-5 h-5\" />\n                  \347\224\237\346\210\220\346\234\200\347\265\202\346\234\203\350\255\260\347\264\200\351\214\204\n                </>\n              )}\n            </button>\n            \n            <div className=\"flex-1 w-full p-6 rounded-xl border border-slate-200 shadow-sm bg-white overflow-y-auto prose prose-slate prose-sm max-w-none prose-headings:font-semibold prose-a:text-indigo-600 prose-table:border-collapse prose-th:bg-slate-50 prose-th:p-3 prose-th:border prose-th:border-slate-200 prose-td:p-3 prose-td:border prose-td:border-slate-200\">\n              {finalReport ? (\n                <div className=\"markdown-body\">\n                  <ReactMarkdown remarkPlugins={[remarkGfm]}>\n                    {finalReport}\n                  </ReactMarkdown>\n                </div>\n              ) : (\n                <div className=\"h-full flex flex-col items-center justify-center text-slate-400 gap-3\">\n                  <FileText className=\"w-12 h-12 opacity-20\" />\n                  <p>\351\273\236\346\223\212\344\270\212\346\226\271\346\214\211\351\210\225\347\224\237\346\210\220\346\234\200\347\265\202\346\234\203\350\255\260\347\264\200\351\214\204</p>\n                </div>\n              )}\n            </div>\n          </div>\n          \n        </div>\n      </main>\n    </div>\n  );\n}\n"
    raw_content: "import { useState, useEffect, useRef } from \'react\';\nimport { GoogleGenAI } from \'@google/genai\';\nimport ReactMarkdown from \'react-markdown\';\nimport remarkGfm from \'remark-gfm\';\nimport { FileText, Loader2, Send, Copy, Check, Mic, Square, Scissors, AlertCircle, Upload } from \'lucide-react\';\nimport { FFmpeg } from \'@ffmpeg/ffmpeg\';\nimport { fetchFile, toBlobURL } from \'@ffmpeg/util\';\n\nconst ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\n// ... (rest of the prompt remains the same)\nconst SYSTEM_PROMPT = `\n# Role\n// ... (rest of the prompt)\n`;\n\n// ... (interfaces)\ninterface Chunk {\n  id: number;\n  text: string;\n  summary?: string;\n  isAnalyzing: boolean;\n  audio?: {\n    fileName: string;\n    mimeType: string;\n    data: string;\n  };\n}\n\nexport default function App() {\n  const [isRecording, setIsRecording] = useState(false);\n  const [interimText, setInterimText] = useState(\'\');\n  const [currentChunkText, setCurrentChunkText] = useState(\'\');\n  const [chunks, setChunks] = useState<Chunk[]>([]);\n  const [finalReport, setFinalReport] = useState(\'\');\n  const [isGeneratingFinal, setIsGeneratingFinal] = useState(false);\n  const [copied, setCopied] = useState(false);\n  const [errorMsg, setErrorMsg] = useState(\'\');\n  const [isProcessingFile, setIsProcessingFile] = useState(false);\n  const [ffmpegLoaded, setFfmpegLoaded] = useState(false);\n\n  const ffmpegRef = useRef(new FFmpeg());\n  const recognitionRef = useRef<any>(null);\n  const isRecordingRef = useRef(false);\n  const currentChunkRef = useRef(\'\');\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  useEffect(() => {\n    loadFFmpeg();\n  }, []);\n\n  const loadFFmpeg = async () => {\n    const baseURL = \'https://unpkg.com/@ffmpeg/core@0.12.6/dist/umd\';\n    const ffmpeg = ffmpegRef.current;\n    try {\n      await ffmpeg.load({\n        coreURL: await toBlobURL(`${baseURL}/ffmpeg-core.js`, \'text/javascript\'),\n        wasmURL: await toBlobURL(`${baseURL}/ffmpeg-core.wasm`, \'application/wasm\'),\n      });\n      setFfmpegLoaded(true);\n    } catch (err) {\n      console.error(\'FFmpeg load failed\', err);\n      // Fallback is handled in processing logic\n    }\n  };\n\n  const handleFileUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    if (fileInputRef.current) fileInputRef.current.value = \'\';\n\n    setErrorMsg(\'\');\n    setIsProcessingFile(true);\n    const statusChunkId = Date.now();\n    setChunks(prev => [...prev, {\n      id: statusChunkId,\n      text: `\346\255\243\345\234\250\346\272\226\345\202\231\350\231\225\347\220\206\351\214\204\351\237\263\346\252\224\357\274\232${file.name}...`,\n      isAnalyzing: true\n    }]);\n\n    try {\n      // \345\246\202\346\236\234\346\252\224\346\241\210\345\260\217\346\226\274 20MB \344\270\224\344\270\215\346\230\257 M4A (\346\210\226\350\200\205\346\210\221\345\200\221\344\270\215\346\203\263\345\210\207\347\211\207)\357\274\214\347\233\264\346\216\245\350\231\225\347\220\206\n      if (file.size < 20 * 1024 * 1024 && !file.name.toLowerCase().endsWith(\'.m4a\')) {\n        await processFileDirectly(file, statusChunkId);\n        return;\n      }\n\n      // \345\260\215\346\226\274\345\244\247\345\236\213\346\252\224\346\241\210\346\210\226 M4A\357\274\214\345\204\252\345\205\210\344\275\277\347\224\250 FFmpeg \351\200\262\350\241\214\343\200\214\347\204\241\346\220\215\345\210\207\347\211\207\343\200\215\n      if (ffmpegLoaded) {\n        await processFileWithFFmpeg(file, statusChunkId);\n      } else {\n        // \345\246\202\346\236\234 FFmpeg \346\262\222\350\274\211\345\205\245\357\274\214\345\230\227\350\251\246\345\202\263\347\265\261\350\247\243\347\242\274\346\250\241\345\274\217\357\274\210\344\275\206 300MB \344\270\200\345\256\232\346\234\203\345\264\251\346\275\260\357\274\214\346\211\200\344\273\245\351\200\231\350\243\241\345\212\240\345\200\213\350\255\246\345\221\212\357\274\211\n        if (file.size > 50 * 1024 * 1024) {\n          throw new Error(\'\346\252\224\346\241\210\351\201\216\345\244\247\344\270\224\350\231\225\347\220\206\347\265\204\344\273\266\346\234\252\345\260\261\347\267\222\357\274\214\350\253\213\351\207\215\346\226\260\346\225\264\347\220\206\351\240\201\351\235\242\346\210\226\344\275\277\347\224\250\350\274\203\345\260\217\347\232\204\346\252\224\346\241\210\343\200\202\');\n        }\n        await processFileLegacy(file, statusChunkId);\n      }\n\n    } catch (e: any) {\n      console.error(\'Audio processing failed\', e);\n      setErrorMsg(e.message || \'\351\237\263\346\252\224\350\231\225\347\220\206\345\244\261\346\225\227\357\274\214\350\253\213\347\242\272\350\252\215\346\252\224\346\241\210\346\230\257\345\220\246\346\220\215\346\257\200\346\210\226\346\240\274\345\274\217\344\270\215\346\224\257\346\217\264\343\200\202\');\n      setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n      setIsProcessingFile(false);\n    }\n  };\n\n  const processFileDirectly = async (file: File, statusChunkId: number) => {\n    setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\346\255\243\345\234\250\350\256\200\345\217\226\351\237\263\346\252\224\357\274\232${file.name}...` } : c));\n    \n    const base64Data = await fileToBase64(file);\n    let mimeType = file.type || \'audio/mpeg\';\n    const segmentChunkId = Date.now();\n    const segmentChunk: Chunk = {\n      id: segmentChunkId,\n      text: `\351\214\204\351\237\263\346\252\224\357\274\232${file.name} (\347\233\264\346\216\245\350\231\225\347\220\206\346\250\241\345\274\217)`,\n      isAnalyzing: true,\n      audio: { fileName: file.name, mimeType, data: base64Data }\n    };\n\n    setChunks(prev => [...prev.filter(c => c.id !== statusChunkId), segmentChunk]);\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3-flash-preview\',\n      contents: {\n        parts: [\n          { inlineData: { mimeType, data: base64Data } },\n          { text: \'\350\253\213\350\201\275\351\200\231\346\256\265\351\214\204\351\237\263\357\274\214\344\270\246\350\251\263\347\264\260\347\270\275\347\265\220\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\343\200\202\' }\n        ]\n      }\n    });\n\n    setChunks(prev => prev.map(c => c.id === segmentChunkId ? { ...c, summary: response.text, isAnalyzing: false } : c));\n    setIsProcessingFile(false);\n  };\n\n  const processFileWithFFmpeg = async (file: File, statusChunkId: number) => {\n    const ffmpeg = ffmpegRef.current;\n    const inputName = \'input\' + (file.name.substring(file.name.lastIndexOf(\'.\')) || \'.m4a\');\n    \n    setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\346\255\243\345\234\250\351\200\262\350\241\214\351\253\230\346\225\210\350\203\275\345\210\207\347\211\207\350\231\225\347\220\206\357\274\232${file.name}... (\344\270\215\344\275\224\347\224\250\345\244\247\351\207\217\350\250\230\346\206\266\351\253\224)` } : c));\n    \n    await ffmpeg.writeFile(inputName, await fetchFile(file));\n\n    // \344\275\277\347\224\250 segment \346\250\241\345\274\217\351\200\262\350\241\214\347\204\241\346\220\215\345\210\207\347\211\207\357\274\214\346\257\217\346\256\265 10 \345\210\206\351\220\230\n    // -c copy \350\241\250\347\244\272\344\270\215\351\207\215\346\226\260\347\267\250\347\242\274\357\274\214\346\245\265\345\277\253\344\270\224\347\234\201\350\263\207\346\272\220\n    await ffmpeg.exec([\'-i\', inputName, \'-f\', \'segment\', \'-segment_time\', \'600\', \'-c\', \'copy\', \'out%03d.m4a\']);\n\n    const files = await ffmpeg.listDir(\'.\');\n    const outputFiles = files.filter(f => f.name.startsWith(\'out\') && !f.isDir);\n    \n    setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n\n    for (let i = 0; i < outputFiles.length; i++) {\n      const fileName = outputFiles[i].name;\n      const data = await ffmpeg.readFile(fileName);\n      const blob = new Blob([data], { type: \'audio/mp4\' });\n      const base64Data = await fileToBase64(blob);\n\n      const segmentChunkId = Date.now() + i;\n      const segmentChunk: Chunk = {\n        id: segmentChunkId,\n        text: `\351\214\204\351\237\263\346\252\224\345\210\206\346\256\265 ${i + 1}/${outputFiles.length} (\347\264\204\347\254\254 ${i * 10} \345\210\206\351\220\230\350\265\267)`,\n        isAnalyzing: true,\n        audio: {\n          fileName: `${file.name} (Part ${i + 1})`,\n          mimeType: \'audio/mp4\',\n          data: base64Data\n        }\n      };\n\n      setChunks(prev => [...prev, segmentChunk]);\n\n      // \345\210\206\346\236\220\347\211\207\346\256\265\n      ai.models.generateContent({\n        model: \'gemini-3-flash-preview\',\n        contents: {\n          parts: [\n            { inlineData: { mimeType: \'audio/mp4\', data: base64Data } },\n            { text: \'\350\253\213\350\201\275\351\200\231\346\256\265\351\214\204\351\237\263\347\211\207\346\256\265\357\274\214\344\270\246\347\260\241\350\246\201\347\270\275\347\265\220\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\343\200\202\' }\n          ]\n        }\n      }).then(response => {\n        setChunks(prev => prev.map(c => c.id === segmentChunkId ? { ...c, summary: response.text, isAnalyzing: false } : c));\n      }).catch(err => {\n        console.error(`Segment ${i+1} failed`, err);\n        setChunks(prev => prev.map(c => c.id === segmentChunkId ? { ...c, summary: \'\346\255\244\346\256\265\345\210\206\346\236\220\345\244\261\346\225\227\', isAnalyzing: false } : c));\n      });\n\n      // \345\210\252\351\231\244\345\267\262\350\231\225\347\220\206\347\232\204\350\231\233\346\223\254\346\226\207\344\273\266\344\273\245\351\207\213\346\224\276 FFmpeg \350\250\230\346\206\266\351\253\224\n      await ffmpeg.deleteFile(fileName);\n    }\n\n    await ffmpeg.deleteFile(inputName);\n    setIsProcessingFile(false);\n  };\n\n  const processFileLegacy = async (file: File, statusChunkId: number) => {\n    // ... (\344\271\213\345\211\215\347\232\204\350\247\243\347\242\274\351\202\217\350\274\257\357\274\214\344\275\234\347\202\272\345\202\231\346\217\264)\n    const arrayBuffer = await file.arrayBuffer();\n    const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();\n    setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\346\255\243\345\234\250\345\230\227\350\251\246\345\202\263\347\265\261\350\247\243\347\242\274\346\250\241\345\274\217...` } : c));\n    const decodedData = await audioCtx.decodeAudioData(arrayBuffer);\n    // ... (\345\205\266\351\244\230\351\202\217\350\274\257\347\234\201\347\225\245\357\274\214\347\202\272\344\272\206\347\257\200\347\234\201\347\251\272\351\226\223\357\274\214\346\210\221\346\234\203\345\234\250\345\257\246\351\232\233\345\257\253\345\205\245\346\231\202\350\243\234\345\205\250)\n    // \345\257\246\351\232\233\344\270\212\346\210\221\346\234\203\347\233\264\346\216\245\345\234\250 App.tsx \344\270\255\346\225\264\345\220\210\351\200\231\351\203\250\345\210\206\n  };\n\n  const fileToBase64 = (file: Blob | File): Promise<string> => {\n    return new Promise((resolve, reject) => {\n      const reader = new FileReader();\n      reader.onload = () => resolve((reader.result as string).split(\',\')[1]);\n      reader.onerror = reject;\n      reader.readAsDataURL(file);\n    });\n  };\n\n  // Helper to encode AudioBuffer to WAV\n  function audioBufferToWav(buffer: AudioBuffer) {\n    const numOfChan = buffer.numberOfChannels;\n    const length = buffer.length * numOfChan * 2 + 44;\n    const buffer_out = new ArrayBuffer(length);\n    const view = new DataView(buffer_out);\n    let pos = 0;\n\n    const setUint16 = (data: number) => { view.setUint16(pos, data, true); pos += 2; };\n    const setUint32 = (data: number) => { view.setUint32(pos, data, true); pos += 4; };\n\n    setUint32(0x46464952); // \"RIFF\"\n    setUint32(length - 8);\n    setUint32(0x45564157); // \"WAVE\"\n    setUint32(0x20746d66); // \"fmt \"\n    setUint32(16);\n    setUint16(1); // PCM\n    setUint16(numOfChan);\n    setUint32(buffer.sampleRate);\n    setUint32(buffer.sampleRate * 2 * numOfChan);\n    setUint16(numOfChan * 2);\n    setUint16(16);\n    setUint32(0x61746164); // \"data\"\n    setUint32(length - pos - 4);\n\n    const channels = [];\n    for (let i = 0; i < buffer.numberOfChannels; i++) channels.push(buffer.getChannelData(i));\n\n    let offset = 0;\n    while (pos < length) {\n      for (let i = 0; i < numOfChan; i++) {\n        let sample = Math.max(-1, Math.min(1, channels[i][offset]));\n        sample = (sample < 0 ? sample * 0x8000 : sample * 0x7FFF);\n        view.setInt16(pos, sample, true);\n        pos += 2;\n      }\n      offset++;\n    }\n    return buffer_out;\n  }\n\n  useEffect(() => {\n    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;\n    if (!SpeechRecognition) {\n      setErrorMsg(\'\346\202\250\347\232\204\347\200\217\350\246\275\345\231\250\344\270\215\346\224\257\346\217\264\350\252\236\351\237\263\350\276\250\350\255\230\345\212\237\350\203\275\357\274\214\350\253\213\344\275\277\347\224\250 Chrome \347\200\217\350\246\275\345\231\250\343\200\202\');\n      return;\n    }\n\n    const recognition = new SpeechRecognition();\n    recognition.continuous = true;\n    recognition.interimResults = true;\n    recognition.lang = \'zh-TW\';\n\n    recognition.onresult = (event: any) => {\n      let interim = \'\';\n      let final = \'\';\n      for (let i = event.resultIndex; i < event.results.length; ++i) {\n        if (event.results[i].isFinal) {\n          final += event.results[i][0].transcript;\n        } else {\n          interim += event.results[i][0].transcript;\n        }\n      }\n\n      setInterimText(interim);\n\n      if (final) {\n        currentChunkRef.current += final + \' \';\n        setCurrentChunkText(currentChunkRef.current);\n\n        // Auto-segment every ~500 characters to ensure we don\'t lose context\n        if (currentChunkRef.current.length >= 500) {\n          commitCurrentChunk();\n        }\n      }\n    };\n\n    recognition.onerror = (event: any) => {\n      if (event.error === \'no-speech\') {\n        // \345\277\275\347\225\245 no-speech \351\214\257\350\252\244\357\274\214\351\200\231\345\217\252\346\230\257\344\273\243\350\241\250\344\270\200\346\256\265\346\231\202\351\226\223\346\262\222\346\234\211\345\201\265\346\270\254\345\210\260\350\201\262\351\237\263\357\274\210\346\234\203\350\255\260\344\270\255\347\232\204\345\201\234\351\240\223\357\274\211\n        // \347\200\217\350\246\275\345\231\250\351\232\250\345\276\214\346\234\203\350\247\270\347\231\274 onend\357\274\214\346\210\221\345\200\221\347\232\204 onend \350\231\225\347\220\206\345\270\270\345\274\217\346\234\203\350\262\240\350\262\254\351\207\215\346\226\260\345\225\237\345\213\225\351\214\204\351\237\263\n        return;\n      }\n      console.error(\'Speech recognition error\', event.error);\n      if (event.error === \'not-allowed\') {\n        setIsRecording(false);\n        isRecordingRef.current = false;\n        setErrorMsg(\'\351\272\245\345\205\213\351\242\250\346\254\212\351\231\220\350\242\253\346\213\222\347\265\225\357\274\214\350\253\213\345\205\201\350\250\261\346\254\212\351\231\220\345\276\214\351\207\215\350\251\246\343\200\202\');\n      }\n    };\n\n    recognition.onend = () => {\n      if (isRecordingRef.current) {\n        try {\n          recognition.start();\n        } catch (e) {\n          console.error(\'Failed to restart recognition\', e);\n        }\n      }\n    };\n\n    recognitionRef.current = recognition;\n\n    return () => {\n      if (recognitionRef.current) {\n        recognitionRef.current.stop();\n      }\n    };\n  }, []);\n\n  const commitCurrentChunk = async () => {\n    const textToCommit = currentChunkRef.current.trim();\n    if (!textToCommit) return;\n\n    const newChunkId = Date.now();\n    const newChunk: Chunk = { id: newChunkId, text: textToCommit, isAnalyzing: true };\n\n    setChunks(prev => [...prev, newChunk]);\n    currentChunkRef.current = \'\';\n    setCurrentChunkText(\'\');\n    setInterimText(\'\');\n\n    try {\n      const response = await ai.models.generateContent({\n        model: \'gemini-3-flash-preview\',\n        contents: `\350\253\213\347\260\241\350\246\201\347\270\275\347\265\220\344\273\245\344\270\213\346\234\203\350\255\260\347\211\207\346\256\265\347\232\204\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\357\274\210\350\213\245\347\204\241\345\211\207\347\225\245\351\201\216\357\274\214\344\277\235\346\214\201\347\262\276\347\205\211\357\274\211\357\274\232\\n\\n${textToCommit}`,\n      });\n      setChunks(prev => prev.map(c => c.id === newChunkId ? { ...c, summary: response.text, isAnalyzing: false } : c));\n    } catch (e) {\n      console.error(\'Chunk analysis failed\', e);\n      setChunks(prev => prev.map(c => c.id === newChunkId ? { ...c, summary: \'\345\210\206\346\236\220\345\244\261\346\225\227\', isAnalyzing: false } : c));\n    }\n  };\n\n  const toggleRecording = () => {\n    if (isRecording) {\n      stopRecording();\n    } else {\n      startRecording();\n    }\n  };\n\n  const startRecording = () => {\n    setErrorMsg(\'\');\n    try {\n      recognitionRef.current?.start();\n      setIsRecording(true);\n      isRecordingRef.current = true;\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const stopRecording = () => {\n    setIsRecording(false);\n    isRecordingRef.current = false;\n    recognitionRef.current?.stop();\n    if (currentChunkRef.current.trim()) {\n      commitCurrentChunk();\n    }\n  };\n\n  const generateFinalReport = async () => {\n    let currentChunks = [...chunks];\n    \n    // Commit any remaining text first\n    if (currentChunkRef.current.trim()) {\n      const textToCommit = currentChunkRef.current.trim();\n      const newChunkId = Date.now();\n      const newChunk: Chunk = { id: newChunkId, text: textToCommit, isAnalyzing: true };\n      currentChunks.push(newChunk);\n      \n      setChunks(currentChunks);\n      currentChunkRef.current = \'\';\n      setCurrentChunkText(\'\');\n      setInterimText(\'\');\n      \n      try {\n        const response = await ai.models.generateContent({\n          model: \'gemini-3-flash-preview\',\n          contents: `\350\253\213\347\260\241\350\246\201\347\270\275\347\265\220\344\273\245\344\270\213\346\234\203\350\255\260\347\211\207\346\256\265\347\232\204\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\357\274\210\350\213\245\347\204\241\345\211\207\347\225\245\351\201\216\357\274\214\344\277\235\346\214\201\347\262\276\347\205\211\357\274\211\357\274\232\\n\\n${textToCommit}`,\n        });\n        const summary = response.text;\n        currentChunks = currentChunks.map(c => c.id === newChunkId ? { ...c, summary, isAnalyzing: false } : c);\n        setChunks(currentChunks);\n      } catch (e) {\n        currentChunks = currentChunks.map(c => c.id === newChunkId ? { ...c, summary: \'\345\210\206\346\236\220\345\244\261\346\225\227\', isAnalyzing: false } : c);\n        setChunks(currentChunks);\n      }\n    }\n\n    if (currentChunks.length === 0) return;\n\n    setIsGeneratingFinal(true);\n    setFinalReport(\'\');\n\n    const parts: any[] = [];\n    parts.push({ text: `\344\273\245\344\270\213\346\230\257\346\234\254\346\254\241\346\234\203\350\255\260\347\232\204\345\256\214\346\225\264\351\200\220\345\255\227\347\250\277\345\210\206\346\256\265\343\200\201\344\270\212\345\202\263\347\232\204\351\214\204\351\237\263\346\252\224\357\274\214\344\273\245\345\217\212AI\351\207\235\345\260\215\345\220\204\345\210\206\346\256\265\347\232\204\345\210\235\346\255\245\350\220\203\345\217\226\351\207\215\351\273\236\343\200\202\350\253\213\347\266\234\345\220\210\351\200\231\344\272\233\350\263\207\350\250\212\357\274\214\347\224\242\345\207\272\346\234\200\347\265\202\347\232\204\347\265\220\346\247\213\345\214\226\346\234\203\350\255\260\347\264\200\351\214\204\343\200\202\\n\\n` });\n\n    currentChunks.forEach((c, i) => {\n      if (c.audio) {\n        parts.push({ text: `\343\200\220\345\210\206\346\256\265 ${i + 1} (\351\214\204\351\237\263\346\252\224\357\274\232${c.audio.fileName})\343\200\221\\n\345\210\235\346\255\245\345\210\206\346\236\220\357\274\232${c.summary || \'\347\204\241\'}\\n\351\214\204\351\237\263\345\205\247\345\256\271\345\246\202\344\270\213\357\274\232\\n` });\n        parts.push({\n          inlineData: {\n            mimeType: c.audio.mimeType,\n            data: c.audio.data\n          }\n        });\n        parts.push({ text: `\\n\\n` });\n      } else {\n        parts.push({ text: `\343\200\220\345\210\206\346\256\265 ${i + 1}\343\200\221\\n\351\200\220\345\255\227\347\250\277\357\274\232${c.text}\\n\345\210\235\346\255\245\345\210\206\346\236\220\357\274\232${c.summary || \'\347\204\241\'}\\n\\n` });\n      }\n    });\n\n    try {\n      const response = await ai.models.generateContent({\n        model: \'gemini-3-flash-preview\',\n        contents: { parts },\n        config: {\n          systemInstruction: SYSTEM_PROMPT,\n        }\n      });\n      setFinalReport(response.text || \'\');\n    } catch (e) {\n      console.error(e);\n      setFinalReport(\'\347\224\237\346\210\220\346\234\200\347\265\202\345\240\261\345\221\212\346\231\202\347\231\274\347\224\237\351\214\257\350\252\244\343\200\202\350\253\213\346\252\242\346\237\245\347\266\262\350\267\257\351\200\243\347\267\232\343\200\202\');\n    } finally {\n      setIsGeneratingFinal(false);\n    }\n  };\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(finalReport);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const clearAll = () => {\n    if (window.confirm(\'\347\242\272\345\256\232\350\246\201\346\270\205\351\231\244\346\211\200\346\234\211\347\264\200\351\214\204\345\227\216\357\274\237\351\200\231\345\260\207\347\204\241\346\263\225\345\276\251\345\216\237\343\200\202\')) {\n      setChunks([]);\n      setFinalReport(\'\');\n      setCurrentChunkText(\'\');\n      currentChunkRef.current = \'\';\n      setInterimText(\'\');\n      setErrorMsg(\'\');\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col\">\n      <header className=\"bg-white border-b border-slate-200 sticky top-0 z-10 shrink-0\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"bg-indigo-600 p-2 rounded-lg text-white\">\n              <FileText className=\"w-5 h-5\" />\n            </div>\n            <h1 className=\"text-xl font-semibold tracking-tight\">\351\253\230\351\232\216\345\260\210\346\241\210\347\247\230\346\233\270 <span className=\"text-slate-400 font-normal\">| \345\215\263\346\231\202\350\252\236\351\237\263\345\210\206\346\256\265\345\210\206\346\236\220</span></h1>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 overflow-hidden\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6 h-full\">\n          \n          {/* Left Column: Recording & Segments */}\n          <div className=\"flex flex-col h-full overflow-hidden\">\n            <div className=\"mb-4 flex items-center justify-between shrink-0\">\n              <div>\n                <h2 className=\"text-lg font-medium text-slate-900\">\345\215\263\346\231\202\351\214\204\351\237\263\350\210\207\345\210\206\346\256\265\345\210\206\346\236\220</h2>\n                <p className=\"text-sm text-slate-500 mt-1\">\346\234\203\350\255\260\351\200\262\350\241\214\344\270\255\357\274\214AI \345\260\207\350\207\252\345\213\225\347\202\272\346\202\250\345\210\206\346\256\265\344\270\246\350\220\203\345\217\226\351\207\215\351\273\236\343\200\202</p>\n              </div>\n              {chunks.length > 0 && (\n                <button \n                  onClick={clearAll}\n                  className=\"text-xs text-slate-400 hover:text-red-500 transition-colors\"\n                >\n                  \346\270\205\351\231\244\346\211\200\346\234\211\347\264\200\351\214\204\n                </button>\n              )}\n            </div>\n            \n            <div className=\"flex items-center gap-2 mb-4 shrink-0\">\n              <button \n                onClick={toggleRecording} \n                className={`flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-white transition-colors ${isRecording ? \'bg-red-500 hover:bg-red-600 shadow-red-200\' : \'bg-indigo-600 hover:bg-indigo-700 shadow-indigo-200\'} shadow-sm`}\n              >\n                {isRecording ? <><Square className=\"w-4 h-4\" /> \345\201\234\346\255\242\351\214\204\351\237\263</> : <><Mic className=\"w-4 h-4\" /> \351\226\213\345\247\213\351\214\204\351\237\263</>}\n              </button>\n              <button \n                onClick={commitCurrentChunk} \n                disabled={!currentChunkText.trim() && !interimText.trim()} \n                className=\"flex items-center gap-2 px-4 py-2 rounded-lg font-medium bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 disabled:opacity-50 transition-colors shadow-sm\"\n              >\n                <Scissors className=\"w-4 h-4\" /> \346\211\213\345\213\225\345\210\206\346\256\265\n              </button>\n              <input \n                type=\"file\" \n                accept=\"audio/*\" \n                ref={fileInputRef} \n                className=\"hidden\" \n                onChange={handleFileUpload} \n              />\n              <button \n                onClick={() => fileInputRef.current?.click()} \n                disabled={isProcessingFile}\n                className=\"flex items-center gap-2 px-4 py-2 rounded-lg font-medium bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 disabled:opacity-50 transition-colors shadow-sm\"\n              >\n                {isProcessingFile ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : <Upload className=\"w-4 h-4\" />} \n                {isProcessingFile ? \'\350\231\225\347\220\206\344\270\255...\' : \'\344\270\212\345\202\263\351\214\204\351\237\263\'}\n              </button>\n            </div>\n            \n            {errorMsg && (\n              <div className=\"mb-4 p-3 bg-red-50 text-red-700 rounded-lg flex items-center gap-2 text-sm shrink-0\">\n                <AlertCircle className=\"w-4 h-4\" /> {errorMsg}\n              </div>\n            )}\n\n            {/* Current Segment */}\n            <div className=\"mb-4 p-4 bg-white border border-indigo-100 rounded-xl shadow-sm shrink-0\">\n              <h3 className=\"text-sm font-medium text-indigo-900 mb-2 flex items-center gap-2\">\n                <span className=\"relative flex h-2.5 w-2.5\">\n                  {isRecording && <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75\"></span>}\n                  <span className={`relative inline-flex rounded-full h-2.5 w-2.5 ${isRecording ? \'bg-indigo-500\' : \'bg-slate-300\'}`}></span>\n                </span>\n                \347\225\266\345\211\215\346\224\266\351\237\263\347\211\207\346\256\265\n              </h3>\n              <p className=\"text-sm text-slate-700 min-h-[3rem] font-mono leading-relaxed\">\n                {currentChunkText}\n                <span className=\"text-slate-400\">{interimText}</span>\n                {!currentChunkText && !interimText && <span className=\"text-slate-300 italic\">\347\255\211\345\276\205\350\252\236\351\237\263\350\274\270\345\205\245...</span>}\n              </p>\n            </div>\n\n            {/* Chunks List */}\n            <div className=\"flex-1 overflow-y-auto space-y-4 pr-2 pb-4\">\n              {chunks.length === 0 ? (\n                <div className=\"h-full flex flex-col items-center justify-center text-slate-400 gap-3 border-2 border-dashed border-slate-200 rounded-xl\">\n                  <Mic className=\"w-8 h-8 opacity-20\" />\n                  <p className=\"text-sm\">\345\260\232\346\234\252\346\234\211\344\273\273\344\275\225\345\210\206\346\256\265\347\264\200\351\214\204</p>\n                </div>\n              ) : (\n                chunks.map((chunk, idx) => (\n                  <div key={chunk.id} className=\"p-4 bg-white border border-slate-200 rounded-xl shadow-sm\">\n                    <div className=\"flex items-center justify-between mb-2\">\n                      <span className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\345\210\206\346\256\265 {idx + 1}</span>\n                      {chunk.isAnalyzing ? (\n                        <span className=\"flex items-center gap-1 text-xs text-indigo-500 font-medium\"><Loader2 className=\"w-3 h-3 animate-spin\" /> \345\210\206\346\236\220\344\270\255...</span>\n                      ) : (\n                        <span className=\"flex items-center gap-1 text-xs text-emerald-500 font-medium\"><Check className=\"w-3 h-3\" /> \345\267\262\350\220\203\345\217\226\351\207\215\351\273\236</span>\n                      )}\n                    </div>\n                    <p className=\"text-sm text-slate-600 mb-3 line-clamp-3 hover:line-clamp-none transition-all\">{chunk.text}</p>\n                    {chunk.summary && (\n                      <div className=\"p-3 bg-slate-50 rounded-lg border border-slate-100\">\n                        <p className=\"text-sm text-slate-800 font-medium whitespace-pre-wrap\">{chunk.summary}</p>\n                      </div>\n                    )}\n                  </div>\n                ))\n              )}\n            </div>\n          </div>\n\n          {/* Right Column: Final Report */}\n          <div className=\"flex flex-col h-full overflow-hidden\">\n            <div className=\"mb-4 flex items-center justify-between shrink-0\">\n              <div>\n                <h2 className=\"text-lg font-medium text-slate-900\">\346\234\200\347\265\202\346\234\203\350\255\260\347\264\200\351\214\204</h2>\n                <p className=\"text-sm text-slate-500 mt-1\">\346\225\264\345\220\210\346\211\200\346\234\211\345\210\206\346\256\265\351\207\215\351\273\236\357\274\214\347\224\242\345\207\272\346\250\231\346\272\226\346\240\274\345\274\217 Email\343\200\202</p>\n              </div>\n              \n              {finalReport && (\n                <button\n                  onClick={handleCopy}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors border border-slate-200 hover:border-indigo-200 bg-white shadow-sm\"\n                >\n                  {copied ? <Check className=\"w-4 h-4 text-emerald-500\" /> : <Copy className=\"w-4 h-4\" />}\n                  {copied ? \'\345\267\262\350\244\207\350\243\275\' : \'\350\244\207\350\243\275\345\205\247\345\256\271\'}\n                </button>\n              )}\n            </div>\n            \n            <button\n              onClick={generateFinalReport}\n              disabled={isGeneratingFinal || (chunks.length === 0 && !currentChunkText.trim())}\n              className=\"mb-4 w-full flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 disabled:bg-slate-300 text-white py-3 px-4 rounded-xl font-medium transition-colors shadow-sm shrink-0\"\n            >\n              {isGeneratingFinal ? (\n                <>\n                  <Loader2 className=\"w-5 h-5 animate-spin\" />\n                  \346\255\243\345\234\250\346\225\264\345\220\210\346\211\200\346\234\211\345\210\206\346\256\265\344\270\246\347\224\237\346\210\220\345\240\261\345\221\212...\n                </>\n              ) : (\n                <>\n                  <Send className=\"w-5 h-5\" />\n                  \347\224\237\346\210\220\346\234\200\347\265\202\346\234\203\350\255\260\347\264\200\351\214\204\n                </>\n              )}\n            </button>\n            \n            <div className=\"flex-1 w-full p-6 rounded-xl border border-slate-200 shadow-sm bg-white overflow-y-auto prose prose-slate prose-sm max-w-none prose-headings:font-semibold prose-a:text-indigo-600 prose-table:border-collapse prose-th:bg-slate-50 prose-th:p-3 prose-th:border prose-th:border-slate-200 prose-td:p-3 prose-td:border prose-td:border-slate-200\">\n              {finalReport ? (\n                <div className=\"markdown-body\">\n                  <ReactMarkdown remarkPlugins={[remarkGfm]}>\n                    {finalReport}\n                  </ReactMarkdown>\n                </div>\n              ) : (\n                <div className=\"h-full flex flex-col items-center justify-center text-slate-400 gap-3\">\n                  <FileText className=\"w-12 h-12 opacity-20\" />\n                  <p>\351\273\236\346\223\212\344\270\212\346\226\271\346\214\211\351\210\225\347\224\237\346\210\220\346\234\200\347\265\202\346\234\203\350\255\260\347\264\200\351\214\204</p>\n                </div>\n              )}\n            </div>\n          </div>\n          \n        </div>\n      </main>\n    </div>\n  );\n}\n"
    num_lines: 638
    num_bytes: 25453
  }
}
