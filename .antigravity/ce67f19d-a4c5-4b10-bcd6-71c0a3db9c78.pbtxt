      arguments_json: "{\"Instruction\":\"Implement smart dual-track upload to prevent memory crashes for large files\",\"ReplacementContent\":\"    try {\\n      // \345\246\202\346\236\234\346\252\224\346\241\210\345\260\217\346\226\274 25MB\357\274\214\347\233\264\346\216\245\344\270\212\345\202\263\345\216\237\345\247\213\346\240\274\345\274\217\357\274\214\344\270\215\351\200\262\350\241\214\350\247\243\347\242\274\357\274\210\351\201\277\345\205\215\350\250\230\346\206\266\351\253\224\345\264\251\346\275\260\357\274\211\\n      if (file.size < 25 * 1024 * 1024) {\\n        setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\346\255\243\345\234\250\350\256\200\345\217\226\351\237\263\346\252\224\357\274\232${file.name}...` } : c));\\n        \\n        const base64Data = await new Promise<string>((resolve, reject) => {\\n          const reader = new FileReader();\\n          reader.onload = () => {\\n            const result = reader.result as string;\\n            resolve(result.split(\',\')[1]);\\n          };\\n          reader.onerror = reject;\\n          reader.readAsDataURL(file);\\n        });\\n\\n        let mimeType = file.type || \'audio/mpeg\';\\n        const segmentChunkId = Date.now();\\n        const segmentChunk: Chunk = {\\n          id: segmentChunkId,\\n          text: `\351\214\204\351\237\263\346\252\224\357\274\232${file.name} (\347\233\264\346\216\245\350\231\225\347\220\206\346\250\241\345\274\217)`,\\n          isAnalyzing: true,\\n          audio: { fileName: file.name, mimeType, data: base64Data }\\n        };\\n\\n        setChunks(prev => [...prev.filter(c => c.id !== statusChunkId), segmentChunk]);\\n\\n        const response = await ai.models.generateContent({\\n          model: \'gemini-3-flash-preview\',\\n          contents: {\\n            parts: [\\n              { inlineData: { mimeType, data: base64Data } },\\n              { text: \'\350\253\213\350\201\275\351\200\231\346\256\265\351\214\204\351\237\263\357\274\214\344\270\246\350\251\263\347\264\260\347\270\275\347\265\220\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\343\200\202\' }\\n            ]\\n          }\\n        });\\n\\n        setChunks(prev => prev.map(c => c.id === segmentChunkId ? { ...c, summary: response.text, isAnalyzing: false } : c));\\n        setIsProcessingFile(false);\\n        return;\\n      }\\n\\n      // \345\217\252\346\234\211\345\244\247\345\236\213\346\252\224\346\241\210\346\211\215\351\200\262\345\205\245\350\247\243\347\242\274\345\210\206\346\256\265\346\250\241\345\274\217\\n      setChunks(prev => prev.map(c => c.id === statusChunkId ? { ...c, text: `\345\201\265\346\270\254\345\210\260\345\244\247\345\236\213\346\252\224\346\241\210\357\274\214\346\255\243\345\234\250\351\200\262\350\241\214\345\256\211\345\205\250\345\210\206\346\256\265\350\231\225\347\220\206\357\274\232${file.name}...` } : c));\\n      \\n      const arrayBuffer = await file.arrayBuffer();\\n      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();\\n      \\n      let decodedData;\\n      try {\\n        decodedData = await audioCtx.decodeAudioData(arrayBuffer);\\n      } catch (decodeError) {\\n        throw new Error(\'\347\204\241\346\263\225\350\247\243\347\242\274\346\255\244\351\237\263\346\252\224\357\274\214\350\253\213\345\230\227\350\251\246\345\260\207\345\205\266\350\275\211\347\202\272 MP3 \345\276\214\345\206\215\344\270\212\345\202\263\343\200\202\');\\n      }\\n      \\n      // \351\231\215\351\240\273\350\207\263 16kHz \345\226\256\350\201\262\351\201\223\344\273\245\347\257\200\347\234\201\347\251\272\351\226\223\\n      const targetSampleRate = 16000;\\n      const offlineCtx = new OfflineAudioContext(1, Math.max(1, decodedData.duration * targetSampleRate), targetSampleRate);\\n      const source = offlineCtx.createBufferSource();\\n      source.buffer = decodedData;\\n      source.connect(offlineCtx.destination);\\n      source.start();\\n      const renderedBuffer = await offlineCtx.startRendering();\\n\\n      // \351\207\213\346\224\276\345\216\237\345\247\213\350\247\243\347\242\274\346\225\270\346\223\232\344\273\245\347\257\200\347\234\201\350\250\230\346\206\266\351\253\224\\n      decodedData = null;\\n\\n      const segmentDuration = 600; // 10 \345\210\206\351\220\230\344\270\200\350\267\263\\n      const totalDuration = renderedBuffer.duration;\\n      const numSegments = Math.ceil(totalDuration / segmentDuration);\\n\\n      setChunks(prev => prev.filter(c => c.id !== statusChunkId));\\n\\n      for (let i = 0; i < numSegments; i++) {\\n        const startOffset = i * segmentDuration;\\n        const endOffset = Math.min((i + 1) * segmentDuration, totalDuration);\\n        const chunkLength = Math.floor((endOffset - startOffset) * targetSampleRate);\\n        \\n        if (chunkLength <= 0) continue;\\n\\n        const chunkBuffer = audioCtx.createBuffer(1, chunkLength, targetSampleRate);\\n        chunkBuffer.copyToChannel(renderedBuffer.getChannelData(0).slice(Math.floor(startOffset * targetSampleRate), Math.floor(endOffset * targetSampleRate)), 0);\\n\\n        const wavData = audioBufferToWav(chunkBuffer);\\n        const wavBlob = new Blob([wavData], { type: \'audio/wav\' });\\n        \\n        const base64Data = await new Promise<string>((resolve) => {\\n          const reader = new FileReader();\\n          reader.onloadend = () => resolve((reader.result as string).split(\',\')[1]);\\n          reader.readAsDataURL(wavBlob);\\n        });\\n\\n        const segmentChunkId = Date.now() + i;\\n        const segmentChunk: Chunk = {\\n          id: segmentChunkId,\\n          text: `\351\214\204\351\237\263\346\252\224\345\210\206\346\256\265 ${i + 1}/${numSegments} (${Math.floor(startOffset/60)}\345\210\206-${Math.floor(endOffset/60)}\345\210\206)`,\\n          isAnalyzing: true,\\n          audio: {\\n           