    instruction: "Remove file size limit and implement audio chunking for large files using Web Audio API"
    replacement_infos {
      original_chunk {
        target_content: "  const handleFileUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    if (fileInputRef.current) fileInputRef.current.value = \'\';\n\n    if (file.size > 15 * 1024 * 1024) {\n      setErrorMsg(\'\351\214\204\351\237\263\346\252\224\345\244\247\345\260\217\344\270\215\350\203\275\350\266\205\351\201\216 15MB\343\200\202\350\213\245\346\252\224\346\241\210\351\201\216\345\244\247\357\274\214\350\253\213\345\210\206\346\256\265\344\270\212\345\202\263\343\200\202\');\n      return;\n    }\n\n    setErrorMsg(\'\');\n\n    const newChunkId = Date.now();\n    const newChunk: Chunk = {\n      id: newChunkId,\n      text: `\345\267\262\344\270\212\345\202\263\351\214\204\351\237\263\346\252\224\357\274\232${file.name}`,\n      isAnalyzing: true,\n    };\n\n    setChunks(prev => [...prev, newChunk]);\n\n    try {\n      const base64Data = await new Promise<string>((resolve, reject) => {\n        const reader = new FileReader();\n        reader.readAsDataURL(file);\n        reader.onload = () => {\n          if (typeof reader.result === \'string\') {\n            resolve(reader.result.split(\',\')[1]);\n          } else {\n            reject(new Error(\'Failed to convert file\'));\n          }\n        };\n        reader.onerror = error => reject(error);\n      });\n\n      let mimeType = file.type;\n      if (!mimeType) {\n        const ext = file.name.split(\'.\').pop()?.toLowerCase();\n        if (ext === \'m4a\') mimeType = \'audio/mp4\';\n        else if (ext === \'mp3\') mimeType = \'audio/mp3\';\n        else if (ext === \'wav\') mimeType = \'audio/wav\';\n        else mimeType = \'audio/mpeg\';\n      }\n\n      setChunks(prev => prev.map(c => c.id === newChunkId ? {\n        ...c,\n        audio: { fileName: file.name, mimeType, data: base64Data }\n      } : c));\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-3-flash-preview\',\n        contents: {\n          parts: [\n            {\n              inlineData: {\n                mimeType,\n                data: base64Data\n              }\n            },\n            {\n              text: \'\350\253\213\350\201\275\351\200\231\346\256\265\351\214\204\351\237\263\357\274\214\344\270\246\347\260\241\350\246\201\347\270\275\347\265\220\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\357\274\210\350\213\245\347\204\241\345\211\207\347\225\245\351\201\216\357\274\214\344\277\235\346\214\201\347\262\276\347\205\211\357\274\211\343\200\202\'\n            }\n          ]\n        }\n      });\n\n      setChunks(prev => prev.map(c => c.id === newChunkId ? { ...c, summary: response.text, isAnalyzing: false } : c));\n    } catch (e) {\n      console.error(\'Audio upload analysis failed\', e);\n      setChunks(prev => prev.map(c => c.id === newChunkId ? { ...c, summary: \'\345\210\206\346\236\220\345\244\261\346\225\227\357\274\214\350\253\213\347\242\272\350\252\215\346\252\224\346\241\210\346\240\274\345\274\217\346\210\226\347\266\262\350\267\257\351\200\243\347\267\232\343\200\202\', isAnalyzing: false } : c));\n    }\n  };"
        replacement_content: "  const handleFileUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    if (fileInputRef.current) fileInputRef.current.value = \'\';\n\n    setErrorMsg(\'\');\n    const statusChunkId = Date.now();\n    setChunks(prev => [...prev, {\n      id: statusChunkId,\n      text: `\346\255\243\345\234\250\350\231\225\347\220\206\345\244\247\345\236\213\351\214\204\351\237\263\346\252\224\357\274\232${file.name}... (\351\200\231\345\217\257\350\203\275\351\234\200\350\246\201\344\270\200\351\273\236\346\231\202\351\226\223)`,\n      isAnalyzing: true\n    }]);\n\n    try {\n      const arrayBuffer = await file.arrayBuffer();\n      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();\n      const decodedData = await audioCtx.decodeAudioData(arrayBuffer);\n      \n      // Downsample to 16kHz Mono to save space and ensure AI compatibility\n      const targetSampleRate = 16000;\n      const offlineCtx = new OfflineAudioContext(1, decodedData.duration * targetSampleRate, targetSampleRate);\n      const source = offlineCtx.createBufferSource();\n      source.buffer = decodedData;\n      source.connect(offlineCtx.destination);\n      source.start();\n      const renderedBuffer = await offlineCtx.startRendering();\n\n      // Split into 10-minute chunks (600 seconds)\n      const segmentDuration = 600; \n      const totalDuration = renderedBuffer.duration;\n      const numSegments = Math.ceil(totalDuration / segmentDuration);\n\n      // Remove the status chunk\n      setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n\n      for (let i = 0; i < numSegments; i++) {\n        const startOffset = i * segmentDuration;\n        const endOffset = Math.min((i + 1) * segmentDuration, totalDuration);\n        const chunkLength = (endOffset - startOffset) * targetSampleRate;\n        \n        const chunkBuffer = audioCtx.createBuffer(1, chunkLength, targetSampleRate);\n        chunkBuffer.copyToChannel(renderedBuffer.getChannelData(0).slice(startOffset * targetSampleRate, endOffset * targetSampleRate), 0);\n\n        const wavData = audioBufferToWav(chunkBuffer);\n        const base64Data = btoa(new Uint8Array(wavData).reduce((data, byte) => data + String.fromCharCode(byte), \'\'));\n\n        const segmentChunkId = Date.now() + i;\n        const segmentChunk: Chunk = {\n          id: segmentChunkId,\n          text: `\351\214\204\351\237\263\346\252\224\345\210\206\346\256\265 ${i + 1}/${numSegments} (${Math.floor(startOffset/60)}\345\210\206-${Math.floor(endOffset/60)}\345\210\206)`,\n          isAnalyzing: true,\n          audio: {\n            fileName: `${file.name} (Part ${i + 1})`,\n            mimeType: \'audio/wav\',\n            data: base64Data\n          }\n        };\n\n        setChunks(prev => [...prev, segmentChunk]);\n\n        // Analyze this segment\n        ai.models.generateContent({\n          model: \'gemini-3-flash-preview\',\n          contents: {\n            parts: [\n              { inlineData: { mimeType: \'audio/wav\', data: base64Data } },\n              { text: \'\350\253\213\350\201\275\351\200\231\346\256\265\351\214\204\351\237\263\347\211\207\346\256\265\357\274\214\344\270\246\347\260\241\350\246\201\347\270\275\347\265\220\351\207\215\351\273\236\343\200\201\346\261\272\350\255\260\350\210\207\345\276\205\350\276\246\344\272\213\351\240\205\343\200\202\' }\n            ]\n          }\n        }).then(response => {\n          setChunks(prev => prev.map(c => c.id === segmentChunkId ? { ...c, summary: response.text, isAnalyzing: false } : c));\n        }).catch(err => {\n          console.error(`Segment ${i+1} failed`, err);\n          setChunks(prev => prev.map(c => c.id === segmentChunkId ? { ...c, summary: \'\346\255\244\346\256\265\345\210\206\346\236\220\345\244\261\346\225\227\', isAnalyzing: false } : c));\n        });\n      }\n\n    } catch (e) {\n      console.error(\'Audio processing failed\', e);\n      setErrorMsg(\'\351\237\263\346\252\224\350\231\225\347\220\206\345\244\261\346\225\227\357\274\214\350\253\213\347\242\272\350\252\215\346\252\224\346\241\210\346\230\257\345\220\246\346\220\215\346\257\200\346\210\226\346\240\274\345\274\217\344\270\215\346\224\257\346\217\264\343\200\202\');\n      setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n    }\n  };\n\n  // Helper to encode AudioBuffer to WAV\n  function audioBufferToWav(buffer: AudioBuffer) {\n    const numOfChan = buffer.numberOfChannels;\n    const length = buffer.length * numOfChan * 2 + 44;\n    const buffer_out = new ArrayBuffer(length);\n    const view = new DataView(buffer_out);\n    let pos = 0;\n\n    const setUint16 = (data: number) => { view.setUint16(pos, data, true); pos += 2; };\n    const setUint32 = (data: number) => { view.setUint32(pos, data, true); pos += 4; };\n\n    setUint32(0x46464952); // \"RIFF\"\n    setUint32(length - 8);\n    setUint32(0x45564157); // \"WAVE\"\n    setUint32(0x20746d66); // \"fmt \"\n    setUint32(16);\n    setUint16(1); // PCM\n    setUint16(numOfChan);\n    setUint32(buffer.sampleRate);\n    setUint32(buffer.sampleRate * 2 * numOfChan);\n    setUint16(numOfChan * 2);\n    setUint16(16);\n    setUint32(0x61746164); // \"data\"\n    setUint32(length - pos - 4);\n\n    const channels = [];\n    for (let i = 0; i < buffer.numberOfChannels; i++) channels.push(buffer.getChannelData(i));\n\n    let offset = 0;\n    while (pos < length) {\n      for (let i = 0; i < numOfChan; i++) {\n        let sample = Math.max(-1, Math.min(1, channels[i][offset]));\n        sample = (sample < 0 ? sample * 0x8000 : sample * 0x7FFF);\n        view.setInt16(pos, sample, true);\n        pos += 2;\n      }\n      offset++;\n    }\n    return buffer_out;\n  }"
      }
