      target_content: "    try {\n      const arrayBuffer = await file.arrayBuffer();\n      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();\n      const decodedData = await audioCtx.decodeAudioData(arrayBuffer);\n      \n      // Downsample to 16kHz Mono to save space and ensure AI compatibility\n      const targetSampleRate = 16000;\n      const offlineCtx = new OfflineAudioContext(1, decodedData.duration * targetSampleRate, targetSampleRate);\n      const source = offlineCtx.createBufferSource();\n      source.buffer = decodedData;\n      source.connect(offlineCtx.destination);\n      source.start();\n      const renderedBuffer = await offlineCtx.startRendering();\n\n      // Split into 10-minute chunks (600 seconds)\n      const segmentDuration = 600; \n      const totalDuration = renderedBuffer.duration;\n      const numSegments = Math.ceil(totalDuration / segmentDuration);\n\n      // Remove the status chunk\n      setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n\n      for (let i = 0; i < numSegments; i++) {\n        const startOffset = i * segmentDuration;\n        const endOffset = Math.min((i + 1) * segmentDuration, totalDuration);\n        const chunkLength = (endOffset - startOffset) * targetSampleRate;\n        \n        const chunkBuffer = audioCtx.createBuffer(1, chunkLength, targetSampleRate);\n        chunkBuffer.copyToChannel(renderedBuffer.getChannelData(0).slice(startOffset * targetSampleRate, endOffset * targetSampleRate), 0);\n\n        const wavData = audioBufferToWav(chunkBuffer);\n        const base64Data = btoa(new Uint8Array(wavData).reduce((data, byte) => data + String.fromCharCode(byte), \'\'));\n\n        const segmentChunkId = Date.now() + i;\n        const segmentChunk: Chunk = {\n          id: segmentChunkId,\n          text: `\351\214\204\351\237\263\346\252\224\345\210\206\346\256\265 ${i + 1}/${numSegments} (${Math.floor(startOffset/60)}\345\210\206-${Math.floor(endOffset/60)}\345\