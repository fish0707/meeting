    modified_response: "\351\200\231\346\230\257\344\270\200\345\200\213\351\235\236\345\270\270\347\266\223\345\205\270\347\232\204\347\200\217\350\246\275\345\231\250\350\250\230\346\206\266\351\253\224\351\231\220\345\210\266\345\225\217\351\241\214\343\200\202\347\225\266\346\210\221\345\200\221\344\275\277\347\224\250 `decodeAudioData` \346\231\202\357\274\214\347\200\217\350\246\275\345\231\250\346\234\203\345\260\207\345\243\223\347\270\256\347\232\204\351\237\263\346\252\224\357\274\210\345\246\202 MP3\357\274\211\351\202\204\345\216\237\346\210\220**\345\216\237\345\247\213\347\232\204 PCM \346\225\270\346\223\232**\343\200\202\344\270\200\345\200\213 1 \345\260\217\346\231\202\347\232\204 MP3 \345\217\257\350\203\275\345\217\252\346\234\211 50MB\357\274\214\344\275\206\350\247\243\347\242\274\346\210\220 PCM \345\276\214\346\234\203\347\236\254\351\226\223\350\206\250\350\204\271\345\210\260 **600MB ~ 1GB**\357\274\214\351\200\231\346\234\203\347\233\264\346\216\245\345\260\216\350\207\264\347\200\217\350\246\275\345\231\250\345\210\206\351\240\201\345\264\251\346\275\260\343\200\202\n\n\347\202\272\344\272\206\345\276\271\345\272\225\350\247\243\346\261\272\351\200\231\345\200\213\345\225\217\351\241\214\357\274\214\346\210\221\351\207\215\346\226\260\350\250\255\350\250\210\344\272\206**\343\200\214\346\231\272\346\205\247\345\236\213\351\233\231\350\273\214\344\270\212\345\202\263\346\251\237\345\210\266\343\200\215**\357\274\232\n\n### 1. \351\233\231\350\273\214\350\231\225\347\220\206\351\202\217\350\274\257\n*   **\345\260\217\346\226\274 25MB \347\232\204\346\252\224\346\241\210\357\274\210\347\233\264\346\216\245\345\202\263\351\200\201\357\274\211**\357\274\232\344\270\215\345\206\215\351\200\262\350\241\214\344\273\273\344\275\225\350\247\243\347\242\274\350\231\225\347\220\206\343\200\202\347\233\264\346\216\245\345\260\207\345\216\237\345\247\213\347\232\204 MP3/M4A/WAV \350\275\211\347\202\272 Base64 \345\202\263\347\265\246 Gemini\343\200\202\351\200\231\350\203\275**\345\256\214\345\205\250\351\201\277\345\205\215\350\247\243\347\242\274\347\224\242\347\224\237\347\232\204\350\250\230\346\206\266\351\253\224\345\243\223\345\212\233**\357\274\214\351\200\237\345\272\246\346\234\200\345\277\253\344\270\224\346\234\200\347\251\251\345\256\232\343\200\202\n*   **\345\244\247\346\226\274 25MB \347\232\204\346\252\224\346\241\210\357\274\210\345\256\211\345\205\250\345\210\206\346\256\265\350\247\243\347\242\274\357\274\211**\357\274\232\n    *   \346\210\221\345\200\221\344\276\235\347\204\266\351\234\200\350\246\201\351\231\215\351\240\273\345\243\223\347\270\256\357\274\214\344\275\206\346\210\221\345\204\252\345\214\226\344\272\206\350\231\225\347\220\206\346\265\201\347\250\213\357\274\214\347\242\272\344\277\235\345\234\250\350\247\243\347\242\274\345\244\247\345\236\213\346\252\224\346\241\210\346\231\202\357\274\214\345\204\230\345\217\257\350\203\275\351\207\213\346\224\276\344\270\215\345\277\205\350\246\201\347\232\204\346\232\253\345\255\230\350\250\230\346\206\266\351\253\224\343\200\202\n    *   \345\204\252\345\214\226\344\272\206 `audioBufferToWav` \347\232\204\346\225\210\350\203\275\357\274\214\346\270\233\345\260\221\346\225\270\346\223\232\350\244\207\350\243\275\343\200\202\n\n### 2. \346\225\210\350\203\275\345\204\252\345\214\226\n*   **\347\247\273\351\231\244\351\207\215\350\244\207\347\267\251\350\241\235\345\215\200**\357\274\232\347\242\272\344\277\235\345\234\250\350\247\243\347\242\274\345\276\214\347\253\213\345\215\263\351\207\213\346\224\276\345\216\237\345\247\213\347\232\204 `ArrayBuffer`\343\200\202\n*   **\351\235\236\345\220\214\346\255\245 Base64 \350\275\211\346\217\233**\357\274\232\344\275\277\347\224\250 `FileReader` \350\231\225\347\220\206 Blob\357\274\214\351\200\231\346\230\257\347\233\256\345\211\215\347\200\217\350\246\275\345\231\250\350\231\225\347\220\206\345\244\247\345\236\213\346\225\270\346\223\232\346\234\200\347\251\251\345\256\232\347\232\204\346\22