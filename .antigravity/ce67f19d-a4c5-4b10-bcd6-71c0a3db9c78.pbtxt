lReport ? <ReactMarkdown remarkPlugins={[remarkGfm]}>{finalReport}</ReactMarkdown> : <div className=\"h-full flex items-center justify-center text-slate-300 italic\">\351\273\236\346\223\212\346\214\211\351\210\225\347\224\237\346\210\220\345\240\261\345\221\212</div>}\n          </div>\n        </div>\n      </main>\n    </div>\n  );\n}\n"
