  planner_response {
    response: "\346\210\221\345\267\262\347\266\223\344\277\256\346\255\243\344\272\206\346\250\241\345\236\213\345\220\215\347\250\261\351\214\257\350\252\244\343\200\202\346\240\271\346\223\232\346\202\250\347\232\204\350\246\201\346\261\202\357\274\214\347\233\256\345\211\215\347\232\204\350\252\236\351\237\263\350\275\211\346\226\207\345\255\227\346\265\201\347\250\213\345\267\262\350\252\277\346\225\264\345\246\202\344\270\213\357\274\232\n\n### 1. \350\252\236\351\237\263\350\275\211\346\226\207\345\255\227 (STT) \351\232\216\346\256\265\n*   **\345\260\210\347\224\250\346\250\241\345\236\213**\357\274\232\345\205\250\351\235\242\345\210\207\346\217\233\350\207\263 `gemini-2.5-flash-native-audio-preview-09-2025`\343\200\202\351\200\231\346\230\257\345\234\250\347\225\266\345\211\215\347\222\260\345\242\203\344\270\255\346\224\257\346\217\264\351\237\263\350\250\212\350\231\225\347\220\206\346\234\200\347\251\251\345\256\232\347\232\204 Gemini 2 \347\263\273\345\210\227\346\250\241\345\236\213\343\200\202\n*   **\344\277\256\346\255\243 404 \351\214\257\350\252\244**\357\274\232\347\247\273\351\231\244\344\271\213\345\211\215\345\244\261\346\225\210\347\232\204 `12-2025` \347\211\210\346\234\254\357\274\214\346\224\271\347\224\250\346\255\243\347\242\272\347\232\204 `09-2025` \347\211\210\346\234\254\343\200\202\n*   **\345\260\210\346\263\250\350\275\211\351\214\204**\357\274\232\346\255\244\351\232\216\346\256\265\346\250\241\345\236\213\345\203\205\350\262\240\350\262\254\345\260\207\351\237\263\350\250\212\347\262\276\346\272\226\350\275\211\346\217\233\347\202\272\351\200\220\345\255\227\347\250\277\357\274\214\344\270\215\351\200\262\350\241\214\351\241\215\345\244\226\347\232\204\346\221\230\350\246\201\346\210\226\345\210\206\346\236\220\357\274\214\344\273\245\347\242\272\344\277\235\345\205\247\345\256\271\347\232\204\345\256\214\346\225\264\346\200\247\343\200\202\n\n### 2. \346\234\203\350\255\260\345\210\206\346\236\220\351\232\216\346\256\265\n*  