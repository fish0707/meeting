    replacement_chunks {
      target_content: "    // Slice into 10-minute segments and re-encode to MP3 for maximum compatibility\n    // Re-encoding ensures that each segment is a valid standalone MP3 file\n    const outputExt = \'.mp3\'; \n    await ffmpeg.exec([\n      \'-i\', inputName, \n      \'-f\', \'segment\', \n      \'-segment_time\', \'600\', \n      \'-c:a\', \'libmp3lame\', \n      \'-b:a\', \'64k\', // 64k is enough for voice and keeps file size small\n      `out%03d${outputExt}`\n    ]);\n\n    const files = await ffmpeg.listDir(\'.\');\n    const outputFiles = files.filter(f => f.name.startsWith(\'out\') && !f.isDir);\n    \n    setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n\n    for (let i = 0; i < outputFiles.length; i++) {\n      const fileName = outputFiles[i].name;\n      const data = await ffmpeg.readFile(fileName);\n      const blob = new Blob([data], { type: \'audio/mpeg\' });\n      const base64Data = await fileToBase64(blob);\n\n      const segmentChunk: Chunk = {\n        id: Date.now() + i,\n        text: `\351\214\204\351\237\263\345\210\206\346\256\265 ${i + 1}/${outputFiles.length} (\347\264\204\347\254\254 ${i * 10} \345\210\206\351\220\230\350\265\267)`,\n        isAnalyzing: true,\n        audio: { fileName: `${file.name} (Part ${i + 1})`, mimeType: \'audio/mpeg\', data: base64Data }\n      };"
      replacement_content: "    // Slice into 10-minute segments and re-encode to MP3\n    // Using mono and 16kHz to optimize for speech recognition and file size\n    const outputExt = \'.mp3\'; \n    await ffmpeg.exec([\n      \'-i\', inputName, \n      \'-vn\', // No video\n      \'-ac\', \'1\', // Mono\n      \'-ar\', \'16000\', // 16kHz\n      \'-f\', \'segment\', \n      \'-segment_time\', \'600\', \n      \'-c:a\', \'libmp3lame\', \n      \'-b:a\', \'48k\', \n      `out%03d${outputExt}`\n    ]);\n\n    const files = await ffmpeg.listDir(\'.\');\n    const outputFiles = files.filter(f => f.name.startsWith(\'out\') && !f.isDir);\n    \n    setChunks(prev => prev.filter(c => c.id !== statusChunkId));\n\n    for (let i = 0; i < outputFiles.length; i++) {\n      const fileName = outputFiles[i].name;\n      const data = await ffmpeg.readFile(fileName);\n      const blob = new Blob([data], { type: \'audio/mpeg\' });\n      const base64Data = await fileToBase64(blob);\n\n      const segmentChunk: Chunk = {\n        id: Date.now() + i,\n        text: `\351\214\204\351\237\263\345\210\206\346\256\265 ${i + 1}/${outputFiles.length} (\347\264\204\347\254\254 ${i * 10} \345\210\206\351\220\230\350\265\267)`,\n        isAnalyzing: true,\n        audio: { fileName: `${file.name} (Part ${i + 1})`, mimeType: \'audio/mpeg\', data: base64Data }\n      };"
